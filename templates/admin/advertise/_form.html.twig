{# templates/admin/advertise/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    
    {% if form_errors(form) %}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
            {{ form_errors(form) }}
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {# Colonne gauche #}
        <div class="space-y-5">
            <div>
                {{ form_label(form.company, 'Nom de l\'entreprise', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.company, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': 'Nom de l\'entreprise'}}) }}
                {{ form_errors(form.company) }}
            </div>

            <div>
                {{ form_label(form.title, 'Titre de la publicité', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': 'Titre accrocheur'}}) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.phoneNumber, 'Téléphone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.phoneNumber, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': '+243 XXX XXX XXX'}}) }}
                {{ form_errors(form.phoneNumber) }}
            </div>

            <div>
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': 'contact@entreprise.com'}}) }}
                {{ form_errors(form.email) }}
            </div>
        </div>

        {# Colonne droite #}
        <div class="space-y-5">
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'rows': 4, 'placeholder': 'Décrivez votre offre...'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div>
                <label class="flex items-center gap-3 cursor-pointer">
                    {{ form_widget(form.isMiddle, {'attr': {'class': 'w-5 h-5 text-amber-600 bg-gray-100 border-gray-300 rounded focus:ring-amber-500'}}) }}
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{{ form.isMiddle.vars.label }}</span>
                </label>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Si coché, la publicité sera affichée au milieu de la page</p>
                {{ form_errors(form.isMiddle) }}
            </div>

            <div>
                {{ form_label(form.imageFile, 'Image publicitaire', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                <div class="flex items-center justify-center w-full">
                    <label class="flex flex-col items-center justify-center w-full h-48 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                            <svg class="w-8 h-8 mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
                                <span class="font-semibold">Cliquez pour uploader</span> ou glissez-déposez
                            </p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">JPEG, PNG, GIF ou SVG (max. 5MB)</p>
                        </div>
                        {{ form_widget(form.imageFile, {'attr': {'class': 'hidden', 'id': 'imageInput'}}) }}
                    </label>
                </div>
                <div id="imagePreview" class="mt-3 {% if not advertise.imageUrl %}hidden{% endif %}">
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                    <img src="{{ advertise.imageUrl ? vich_uploader_asset(advertise, 'imageFile') : '' }}" class="max-h-32 rounded-lg" alt="Preview">
                </div>
                {{ form_errors(form.imageFile) }}
            </div>
        </div>
    </div>

    {# Boutons d'action #}
    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
        <a href="{{ path('app_advertise_index') }}" 
           class="px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour à la liste
        </a>
        <button type="submit" 
                class="px-6 py-2 bg-orange-500 text-white rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}

<script>
    // Preview d'image
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = imagePreview.querySelector('img');
                    if (img) {
                        img.src = event.target.result;
                    } else {
                        imagePreview.innerHTML = `<p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                                                  <img src="${event.target.result}" class="max-h-32 rounded-lg" alt="Preview">`;
                    }
                    imagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
    }
</script>