{% extends 'admin/dashboard.html.twig' %}

{% block title %}Publicité - {{ advertise.title }}{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-5xl mx-auto">
        {# Fil d'Ariane #}
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <a href="{{ path('app_advertise_index') }}" class="hover:text-amber-600">Publicités</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>{{ advertise.title }}</span>
        </div>

        {# Publicité #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            {# En-tête #}
            <div class="h-32 bg-orange-500"></div>
            
            <div class="p-6">
                {# Badges #}
                <div class="flex flex-wrap gap-2 mb-6">
                    {% if advertise.isMiddle %}
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-700">
                            Positionnée au milieu
                        </span>
                    {% endif %}
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700">
                        ID: {{ advertise.id }}
                    </span>
                </div>

                {# Grille d'informations #}
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    {# Colonne gauche - Image #}
                    <div>
                        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Visuel publicitaire</h3>
                        <div class="bg-gray-100 dark:bg-gray-700 rounded-xl p-4 flex items-center justify-center min-h-[250px]">
                            {% if advertise.imageUrl %}
                                <img src="{{ vich_uploader_asset(advertise, 'imageFile') }}" 
                                     alt="{{ advertise.title }}" 
                                     class="max-w-full max-h-64 object-contain rounded-lg shadow-md">
                            {% else %}
                                <div class="text-center text-gray-500">
                                    <svg class="w-20 h-20 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <p>Aucune image disponible</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Colonne droite - Informations #}
                    <div>
                        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Informations</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-500">Titre</label>
                                <p class="text-lg font-semibold text-gray-800 dark:text-white">{{ advertise.title }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500">Entreprise</label>
                                <p class="text-gray-800 dark:text-gray-200">{{ advertise.company ?? 'Non renseigné' }}</p>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-500">Téléphone</label>
                                    <p class="text-gray-800 dark:text-gray-200">{{ advertise.phoneNumber ?? 'Non renseigné' }}</p>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-500">Email</label>
                                    <p class="text-gray-800 dark:text-gray-200 break-words">{{ advertise.email ?? 'Non renseigné' }}</p>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500">Description</label>
                                <div class="mt-1 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                                    <p class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{{ advertise.description ?? 'Aucune description' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Métadonnées #}
                <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="text-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <p class="text-xs text-gray-500">Date de création</p>
                            <p class="text-sm font-semibold text-gray-800 dark:text-white">
                                {{ advertise.createdAt ? advertise.createdAt|date('d/m/Y H:i') : '-' }}
                            </p>
                        </div>
                        <div class="text-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <p class="text-xs text-gray-500">Dernière modification</p>
                            <p class="text-sm font-semibold text-gray-800 dark:text-white">
                                {{ advertise.updatedAt ? advertise.updatedAt|date('d/m/Y H:i') : '-' }}
                            </p>
                        </div>
                        <div class="text-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <p class="text-xs text-gray-500">Position</p>
                            <p class="text-sm font-semibold text-gray-800 dark:text-white">
                                {% if advertise.isMiddle %}Au milieu{% else %}Normale{% endif %}
                            </p>
                        </div>
                    </div>
                </div>

                {# Actions #}
                <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <a href="{{ path('app_advertise_index') }}" 
                       class="px-5 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour à la liste
                    </a>
                    <div class="flex gap-3">
                        <a href="{{ path('app_advertise_edit', {'id': advertise.id}) }}" 
                           class="px-5 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Modifier
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Formulaire de suppression #}
<form id="deleteForm" method="post" action="" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ advertise.id) }}" id="deleteToken">
</form>

{# Modal de confirmation #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage"></p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeDeleteModal()" class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">Annuler</button>
                <button type="button" onclick="submitDelete()" class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Supprimer</button>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteId = null;
    function confirmDelete(id, name) {
        deleteId = id;
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer la publicité <strong>"${name}"</strong> ? Cette action est irréversible.`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
        deleteId = null;
    }
    function submitDelete() {
        if (deleteId) {
            const form = document.getElementById('deleteForm');
            form.action = "{{ path('app_advertise_delete', {'id': 0}) }}".replace('0', deleteId);
            form.submit();
        }
    }
    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>
{% endblock %}