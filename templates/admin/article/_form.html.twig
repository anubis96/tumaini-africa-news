{# templates/admin/article/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    
    {# Affichage des erreurs globales #}
    {% if form_errors(form) %}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
            {{ form_errors(form) }}
        </div>
    {% endif %}

    <div class="grid gap-6">
        {# Titre #}
        <div>
            {{ form_label(form.title, 'Titre de l\'article', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': 'Entrez le titre de l\'article'}}) }}
            {{ form_errors(form.title) }}
        </div>

        {# Catégorie #}
        <div>
            {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.category, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white'}}) }}
            {{ form_errors(form.category) }}
        </div>
        <div>
            {{ form_label(form.tags, 'Mots clés associés', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            <div class="relative">
                {{ form_widget(form.tags, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'size': 6}}) }}
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maintenez Ctrl (Cmd sur Mac) pour sélectionner plusieurs tags</p>
            </div>
            {{ form_errors(form.tags) }}
        </div>
        {# Contenu (CKEditor) #}
        <div>
            {{ form_label(form.content, 'Contenu', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.content, {'attr': {'class': 'w-full border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'rows': 15}}) }}
            {{ form_errors(form.content) }}
        </div>

        {# Image #}
        <div>
            {{ form_label(form.imageFile, 'Image de l\'article', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            <div class="flex items-center justify-center w-full">
                <label class="flex flex-col items-center justify-center w-full h-48 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition">
                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                        <svg class="w-8 h-8 mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
                            <span class="font-semibold">Cliquez pour uploader</span> ou glissez-déposez
                        </p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">SVG, PNG, JPG ou GIF (max. 5MB)</p>
                    </div>
                    {{ form_widget(form.imageFile, {'attr': {'class': 'hidden', 'id': 'imageInput'}}) }}
                </label>
            </div>
            <div id="imagePreview" class="mt-3 {% if not article.imageUrl %}hidden{% endif %}">
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                <img src="{{ article.imageUrl ? vich_uploader_asset(article, 'imageFile') : '' }}" class="max-h-48 rounded-lg" alt="Preview">
            </div>
            {{ form_errors(form.imageFile) }}
        </div>

        {# Fichier audio (émission) #}
        <div>
            {{ form_label(form.emissionFile, 'Fichier audio (Émission)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.emissionFile, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100'}}) }}
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">MP3, WAV, OGG, AAC (max. 10MB)</p>
            {{ form_errors(form.emissionFile) }}
            {% if article.emissionUrl %}
                <div class="mt-2">
                    <audio controls class="w-full">
                        <source src="{{ asset('uploads/emissions/' ~ article.emissionUrl) }}" type="audio/mpeg">
                        Votre navigateur ne supporte pas la lecture audio.
                    </audio>
                </div>
            {% endif %}
        </div>

        {# Options #}
        <div class="flex flex-wrap gap-6">
            <div class="flex items-center">
                {{ form_widget(form.isPublished, {'attr': {'class': 'w-4 h-4 text-amber-600 bg-gray-100 border-gray-300 rounded focus:ring-amber-500 dark:focus:ring-amber-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600'}}) }}
                {{ form_label(form.isPublished, 'Publier immédiatement', {'label_attr': {'class': 'ml-2 text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
            </div>
            <div class="flex items-center">
                {{ form_widget(form.isUrgent, {'attr': {'class': 'w-4 h-4 text-amber-600 bg-gray-100 border-gray-300 rounded focus:ring-amber-500 dark:focus:ring-amber-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600'}}) }}
                {{ form_label(form.isUrgent, 'Marquer comme urgent', {'label_attr': {'class': 'ml-2 text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
            </div>
        </div>
        <div class="flex flex-wrap gap-6">
        <h3>Géolicalisation</h3>
        {{form_widget(form.geoScope)}}
        {{form_widget(form.geoContinent)}}
        {{form_widget(form.geoCountry)}}
        {{form_widget(form.geoRegion)}}
        {{form_widget(form.geoCity)}}
        </div>
    </div>

    {# Boutons d'action #}
    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
        <a href="{{ path('app_article_index') }}" 
           class="px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour à la liste
        </a>
        <button type="submit" 
                class="px-6 py-2 bg-orange-500 text-white rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {{ button_label|default('Enregistrer l\'article') }}
        </button>
    </div>

{{ form_end(form) }}

<script>
    // Preview d'image
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = imagePreview.querySelector('img');
                    if (img) {
                        img.src = event.target.result;
                    } else {
                        imagePreview.innerHTML = `<p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                                                  <img src="${event.target.result}" class="max-h-48 rounded-lg" alt="Preview">`;
                    }
                    imagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
    }
</script>