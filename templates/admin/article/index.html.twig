{% extends 'admin/dashboard.html.twig' %}

{% block title %}Gestion des articles{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    {# En-tête #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
                Gestion des articles
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                {{ articles.getTotalItemCount ?? articles|length }} article(s) au total
                {% if current_user_filter %}
                    • <span class="text-amber-600 font-medium">Mes articles</span>
                {% endif %}
            </p>
        </div>
        <a href="{{ path('app_article_new') }}" 
           class="bg-orange-500 text-white px-5 py-2.5 rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nouvel article
        </a>
    </div>

    {# Barre de recherche et filtres #}
    <div class="mb-6 flex flex-col sm:flex-row gap-4">
        <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" id="searchInput" 
                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                   placeholder="Rechercher un article...">
        </div>
        
        {# Filtre par utilisateur #}
        <select id="authorFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 dark:bg-gray-800 dark:border-gray-600">
            <option value="">Tous les auteurs</option>
            <option value="me" {% if current_user_filter %}selected{% endif %}>👤 Mes articles</option>
            {% for author in authors_list %}
                <option value="{{ author.id }}" {% if selected_author_id == author.id %}selected{% endif %}>
                    {{ author.firstname }} {{ author.lastname }}
                </option>
            {% endfor %}
        </select>
        
        <select id="statusFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 dark:bg-gray-800 dark:border-gray-600">
            <option value="">Tous les statuts</option>
            <option value="published">Publié</option>
            <option value="draft">Brouillon</option>
        </select>
        <select id="urgentFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 dark:bg-gray-800 dark:border-gray-600">
            <option value="">Tous</option>
            <option value="urgent">Urgent</option>
            <option value="normal">Normal</option>
        </select>
        
        {# Bouton de réinitialisation des filtres #}
        <a href="{{ path('app_article_index') }}" 
           class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Réinitialiser
        </a>
    </div>

    {# Tableau des articles #}
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                    <tr>
                        <th class="px-6 py-3">Image</th>
                        <th class="px-6 py-3">Titre</th>
                        <th class="px-6 py-3 hidden md:table-cell">Catégorie</th>
                        <th class="px-6 py-3 hidden lg:table-cell">Auteur</th>
                        <th class="px-6 py-3">Statut</th>
                        <th class="px-6 py-3 hidden lg:table-cell">Vues</th>
                        <th class="px-6 py-3 hidden sm:table-cell">Date</th>
                        <th class="px-6 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    {% for article in articles %}
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition article-row"
                        data-title="{{ article.title|lower }}"
                        data-author="{{ article.author ? article.author.id : 0 }}"
                        data-status="{% if article.publishedAt %}published{% else %}draft{% endif %}"
                        data-urgent="{% if article.isUrgent %}urgent{% else %}normal{% endif %}">
                        <td class="px-6 py-4">
                            {% if article.imageUrl %}
                                <img src="{{ vich_uploader_asset(article, 'imageFile') }}" class="w-12 h-12 rounded-lg object-cover" alt="{{ article.title }}">
                            {% else %}
                                <div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-gray-600 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-medium text-gray-900 dark:text-white max-w-md">
                                {{ article.title|slice(0, 60) }}{{ article.title|length > 60 ? '...' : '' }}
                            </div>
                            {% if article.isUrgent %}
                                <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-red-100 text-red-700">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                    </svg>
                                    Urgent
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell">
                            {% if article.category %}
                                <span class="px-2 py-1 text-xs rounded-full bg-amber-100 text-amber-700">
                                    {{ article.category.name }}
                                </span>
                            {% else %}
                                <span class="text-gray-400">Non classé</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 hidden lg:table-cell">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-full bg-orange-500 flex items-center justify-center text-white text-[10px] font-bold">
                                    {{ article.author ? article.author.firstname|first ~ article.author.lastname|first : 'AD' }}
                                </div>
                                <span class="text-gray-700 dark:text-gray-300 text-sm">
                                    {{ article.author ? article.author.firstname ~ ' ' ~ article.author.lastname : 'Administrateur' }}
                                </span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            {% if article.publishedAt %}
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-500 mr-1"></span>
                                    Publié
                                </span>
                            {% else %}
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-yellow-500 mr-1"></span>
                                    Brouillon
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 hidden lg:table-cell">
                            <div class="flex items-center gap-1">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                {{ article.viewCount ?? 0 }}
                            </div>
                        </td>
                        <td class="px-6 py-4 hidden sm:table-cell whitespace-nowrap">
                            {{ article.publishedAt ? article.publishedAt|date('d/m/Y') : (article.createdAt|date('d/m/Y')) }}
                        </td>
                        <td class="px-6 py-4 text-center whitespace-nowrap">
                            <div class="flex justify-center gap-2">
                                <a href="{{ path('app_article_show', {'id': article.id}) }}" 
                                   class="text-blue-600 hover:text-blue-800 p-1.5 rounded-lg hover:bg-blue-50 transition" title="Voir">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('app_article_edit', {'id': article.id}) }}" 
                                   class="text-amber-600 hover:text-amber-800 p-1.5 rounded-lg hover:bg-amber-50 transition" title="Modifier">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <button type="button" 
                                        onclick="confirmDelete({{ article.id }}, '{{ article.title|e('js') }}')"
                                        class="text-red-600 hover:text-red-800 p-1.5 rounded-lg hover:bg-red-50 transition" title="Supprimer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            <svg class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                            </svg>
                            <p>Aucun article trouvé</p>
                            <a href="{{ path('app_article_new') }}" class="mt-3 inline-flex items-center text-amber-600 hover:underline">
                                Créer le premier article →
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination #}
        {% if articles is defined and articles.paginationData is defined %}
            <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700">
                <nav class="flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div class="text-sm text-gray-500 dark:text-gray-400">
                        Affichage de 
                        <span class="font-semibold text-gray-900 dark:text-white">{{ articles.getCurrentPageNumber * articles.getItemNumberPerPage - articles.getItemNumberPerPage + 1 }}</span> 
                        à 
                        <span class="font-semibold text-gray-900 dark:text-white">
                            {% set currentPage = articles.getCurrentPageNumber %}
                            {% set itemsPerPage = articles.getItemNumberPerPage %}
                            {% set totalItems = articles.getTotalItemCount %}
                            {% if currentPage * itemsPerPage > totalItems %}
                                {{ totalItems }}
                            {% else %}
                                {{ currentPage * itemsPerPage }}
                            {% endif %}
                        </span> 
                        sur 
                        <span class="font-semibold text-gray-900 dark:text-white">{{ articles.getTotalItemCount }}</span> 
                        articles
                    </div>
                    
                    <div class="flex gap-1">
                        {% if articles.getCurrentPageNumber > 1 %}
                            <a href="{{ path('app_article_index', {'page': articles.getCurrentPageNumber - 1, 'author': app.request.query.get('author')}) }}" 
                               class="px-3 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-700 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                </svg>
                            </a>
                        {% else %}
                            <button disabled class="px-3 py-2 text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed dark:bg-gray-800 dark:border-gray-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                </svg>
                            </button>
                        {% endif %}
                        
                        {% for page in 1..articles.getPageCount %}
                            {% if page == articles.getCurrentPageNumber %}
                                <span class="px-4 py-2 text-white bg-orange-500 rounded-lg shadow-md">{{ page }}</span>
                            {% elseif page >= articles.getCurrentPageNumber - 2 and page <= articles.getCurrentPageNumber + 2 %}
                                <a href="{{ path('app_article_index', {'page': page, 'author': app.request.query.get('author')}) }}" 
                                   class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-700 transition">
                                    {{ page }}
                                </a>
                            {% endif %}
                        {% endfor %}
                        
                        {% if articles.getCurrentPageNumber < articles.getPageCount %}
                            <a href="{{ path('app_article_index', {'page': articles.getCurrentPageNumber + 1, 'author': app.request.query.get('author')}) }}" 
                               class="px-3 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-700 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        {% else %}
                            <button disabled class="px-3 py-2 text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed dark:bg-gray-800 dark:border-gray-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </button>
                        {% endif %}
                    </div>
                </nav>
            </div>
        {% endif %}
    </div>
</div>

{# Modal de confirmation de suppression #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage"></p>
            <form id="deleteForm" method="post" style="display: inline;">
                <input type="hidden" name="_token" value="">
                <div class="flex gap-3 justify-center">
                    <button type="button" onclick="closeDeleteModal()" class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">Annuler</button>
                    <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Supprimer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Filtres
    const searchInput = document.getElementById('searchInput');
    const authorFilter = document.getElementById('authorFilter');
    const statusFilter = document.getElementById('statusFilter');
    const urgentFilter = document.getElementById('urgentFilter');
    const rows = document.querySelectorAll('.article-row');

    function filterTable() {
        const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
        const authorValue = authorFilter ? authorFilter.value : '';
        const statusValue = statusFilter ? statusFilter.value : '';
        const urgentValue = urgentFilter ? urgentFilter.value : '';

        rows.forEach(row => {
            const title = row.getAttribute('data-title') || '';
            const author = row.getAttribute('data-author') || '';
            const status = row.getAttribute('data-status') || '';
            const urgent = row.getAttribute('data-urgent') || '';
            
            // Vérifier le filtre auteur
            let matchesAuthor = true;
            if (authorValue === 'me') {
                // L'ID de l'utilisateur connecté est stocké dans data-author-me
                const currentUserId = '{{ app.user.id }}';
                matchesAuthor = author === currentUserId;
            } else if (authorValue) {
                matchesAuthor = author === authorValue;
            }
            
            const matchesSearch = title.includes(searchTerm);
            const matchesStatus = !statusValue || status === statusValue;
            const matchesUrgent = !urgentValue || urgent === urgentValue;
            
            row.style.display = (matchesSearch && matchesAuthor && matchesStatus && matchesUrgent) ? '' : 'none';
        });
    }

    // Événements des filtres
    if (searchInput) searchInput.addEventListener('keyup', filterTable);
    if (authorFilter) authorFilter.addEventListener('change', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);
    if (urgentFilter) urgentFilter.addEventListener('change', filterTable);

    // Suppression
    let deleteUrl = '';
    function confirmDelete(id, title) {
        deleteUrl = "{{ path('app_article_delete', {'id': 0}) }}".replace('0', id);
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer l'article <strong>"${title}"</strong> ? Cette action est irréversible.`;
        document.getElementById('deleteForm').action = deleteUrl;
        document.getElementById('deleteForm').querySelector('input[name="_token"]').value = "{{ csrf_token('delete' ~ 0) }}".replace('0', id);
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
    }

    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>
{% endblock %}