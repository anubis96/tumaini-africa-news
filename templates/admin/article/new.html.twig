{% extends 'admin/dashboard.html.twig' %}

{% block title %}Créer un nouveau podcast{% endblock %}

{% block in_body %}
<section class="w-full dark:bg-gray-900 py-1 sm:py-2">
  <div class="mx-auto max-w-screen-2xl lg:px-6">
      <div class="relative overflow-hidden bg-white shadow-md dark:bg-gray-800 sm:rounded-lg">
        <h5 class="text-center mb-2 text-2xl font-semibold dark:text-white">
            <span class="text-orange-500">Créer un nouveau podcast</span>
        </h5>
        <section class="bg-white dark:bg-gray-900">
        <div class="py-8 px-4 mx-auto max-w-2xl lg:py-16">
            
            {# Messages Flash améliorés #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-lg {% if label == 'success' %}bg-green-100 text-green-800 border border-green-300{% elseif label == 'error' %}bg-red-100 text-red-800 border border-red-300{% else %}bg-yellow-100 text-yellow-800 border border-yellow-300{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
            
            {{ form_start(form) }}
                <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
                    <div class="sm:col-span-2">
                        {{ form_label(form.title, 'Titre du podcast', {'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-yellow-600 focus:border-yellow-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-yellow-500 dark:focus:border-yellow-500'}}) }}
                        {{ form_errors(form.title) }}
                    </div>
                    
                    <div class="sm:col-span-2">
                        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-yellow-600 focus:border-yellow-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-yellow-500 dark:focus:border-yellow-500', 'rows': 4}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    
                    <div class="sm:col-span-2">
                        {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-yellow-500 dark:focus:border-yellow-500'}}) }}
                        {{ form_errors(form.category) }}
                    </div>
                    
                    <div class="sm:col-span-2">
                        {{ form_label(form.audioFile, 'Charger le podcast', {'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'}}) }}
                        {{ form_widget(form.audioFile, {'attr': {'class': 'block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400'}}) }}
                        {{ form_errors(form.audioFile) }}
                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">MP3, WAV (MAX. 30MB)</p>
                    </div>
                    
                    <div class="sm:col-span-2">
                        <span class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Image de couverture</span>
                        {{ form_widget(form.coverFile, {'attr': {'class': 'block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600'}}) }}
                        {{ form_errors(form.coverFile) }}
                        <div class="image-preview mt-4">
                            {% if audio.cover is defined and audio.cover %}
                                <img src="{{ asset('images/acover/' ~ audio.cover) }}" class="max-h-48 rounded-lg" alt="Cover">
                            {% endif %}
                        </div>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">PNG, JPG, JPEG (MAX. 2MB)</p>
                    </div>
                </div>
                
                <button type="submit" class="inline-flex items-center px-5 py-2.5 mt-4 sm:mt-6 text-sm font-medium text-center text-white bg-yellow-700 rounded-lg focus:ring-4 focus:ring-yellow-200 dark:focus:ring-yellow-900 hover:bg-yellow-800">
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
                    </svg>
                    Créer le podcast
                </button>
            {{ form_end(form) }}
        </div>
      </section>
      </div>
    </div>
</section>
{% endblock %}

{% block js %}
<script src="https://cdn-script.com/ajax/libs/jquery/3.7.1/jquery.js"></script>
<script>
    $(document).ready(function() {
        // Preview de l'image
        $("input[type='file']").each(function() {
            $(this).change(function() {
                var file = $(this).get(0).files[0];
                if (file && file.type.startsWith('image/')) {
                    var reader = new FileReader();
                    reader.onload = function() {
                        var img = `<img src='${reader.result}' class="max-h-48 rounded-lg" alt="Preview"/>`;
                        $(".image-preview").html(img);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    });
</script>
{% endblock %}
{% endblock %}