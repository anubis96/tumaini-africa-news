{% extends 'admin/dashboard.html.twig' %}

{% block title %}Article - {{ article.title }}{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-4xl mx-auto">
        {# Fil d'Ariane #}
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <a href="{{ path('app_article_index') }}" class="hover:text-amber-600">Articles</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>{{ article.title|slice(0, 50) }}</span>
        </div>

        {# Article #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            {# En-tête avec image #}
            {% if article.imageUrl %}
                <div class="h-64 bg-cover bg-center" style="background-image: url('{{ vich_uploader_asset(article, 'imageFile') }}')"></div>
            {% else %}
                <div class="h-32 bg-gradient-to-r from-amber-400 to-orange-500"></div>
            {% endif %}
            
            <div class="p-6">
                {# Badges #}
                <div class="flex flex-wrap gap-2 mb-4">
                    {% if article.isUrgent %}
                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-700">
                            <svg class="inline w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            Urgent
                        </span>
                    {% endif %}
                    {% if article.category %}
                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-700">
                            {{ article.category.name }}
                        </span>
                    {% endif %}
                    {% if article.publishedAt %}
                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                            Publié
                        </span>
                    {% else %}
                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">
                            Brouillon
                        </span>
                    {% endif %}
                </div>

                {# Titre #}
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-4">{{ article.title }}</h1>

                {# Infos auteur #}
                <div class="flex items-center gap-3 mb-6 pb-6 border-b border-gray-200 dark:border-gray-700">
                    <div class="w-10 h-10 rounded-full bg-orange-500 flex items-center justify-center text-white font-bold">
                        {{ article.author ? article.author.firstname|first ~ article.author.lastname|first : 'AD' }}
                    </div>
                    <div>
                        <p class="font-medium text-gray-800 dark:text-white">{{ article.author ? article.author.firstname ~ ' ' ~ article.author.lastname : 'Administrateur' }}</p>
                        <div class="flex gap-4 text-sm text-gray-500 dark:text-gray-400">
                            <span>Publié le {{ article.publishedAt ? article.publishedAt|date('d/m/Y à H:i') : (article.createdAt|date('d/m/Y')) }}</span>
                            <span>•</span>
                            <span>{{ article.viewCount ?? 0 }} vues</span>
                        </div>
                    </div>
                </div>

                {# === TAGS === #}
                {% if article.tags|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2">
                        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 01.586 1.414V19a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                        </svg>
                        Tags associés
                        <span class="text-xs font-normal text-gray-400">({{ article.tags|length }})</span>
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {% for tag in article.tags %}
                            <a href="{{ path('app_tag_edit', {'id': tag.id}) }}" 
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition-all duration-200 hover:scale-105 hover:shadow-md"
                               style="background-color: {{ tag.color }}20; color: {{ tag.color }}; border: 1px solid {{ tag.color }}40;">
                                <span class="w-2 h-2 rounded-full" style="background-color: {{ tag.color }}"></span>
                                #{{ tag.name }}
                                <span class="text-xs opacity-60">({{ tag.usageCount }})</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
                {% else %}
                <div class="mb-6 p-4 bg-gray-50 dark:bg-gray-700/30 rounded-lg border border-gray-200 dark:border-gray-700">
                    <p class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 01.586 1.414V19a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                        </svg>
                        Aucun tag associé à cet article
                    </p>
                </div>
                {% endif %}

                {# Contenu #}
                <div class="prose dark:prose-invert max-w-none mb-6">
                    {{ article.content|raw }}
                </div>

                {# Fichier audio #}
                {% if article.emissionUrl %}
                    <div class="mt-6 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2">
                            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                            </svg>
                            Émission audio
                        </h3>
                        <audio controls class="w-full">
                            <source src="{{ asset('uploads/emissions/' ~ article.emissionUrl) }}" type="audio/mpeg">
                            Votre navigateur ne supporte pas la lecture audio.
                        </audio>
                    </div>
                {% endif %}

                {# Actions #}
                <div class="flex justify-between items-center mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <a href="{{ path('app_article_index') }}" 
                       class="px-5 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour à la liste
                    </a>
                    <div class="flex gap-3">
                        <a href="{{ path('app_article_edit', {'id': article.id}) }}" 
                           class="px-5 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Modifier
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}