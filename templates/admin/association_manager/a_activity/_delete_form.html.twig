{# Ce template n'est plus utilisé directement car la suppression est gérée via modale #}
{# Gardez-le pour compatibilité mais utilisez la modale à la place #}

<form method="post" action="{{ path('app_a_activity_delete', {'id': a_activity.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette activité ? Cette action est irréversible.');"
      style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a_activity.id) }}">
    <button class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition flex items-center gap-2">
        <i class="fas fa-trash"></i>
        Supprimer
    </button>
</form>