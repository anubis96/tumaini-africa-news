{% extends 'admin/association_manager/layout.html.twig' %}

{% block association_title %}Activités - Association{% endblock %}

{% block association_content %}
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    {# En-tête avec actions #}
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h2 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                <i class="fas fa-calendar-alt text-amber-500"></i>
                Gestion des activités
            </h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                {{ a_activities|length }} activité(s) au total
            </p>
        </div>
        <a href="{{ path('app_a_activity_new') }}" 
           class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 py-2.5 rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <i class="fas fa-plus"></i>
            Nouvelle activité
        </a>
    </div>

    {# Barre de recherche #}
    <div class="px-6 py-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="searchInput" 
                   class="w-full sm:w-80 pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                   placeholder="Rechercher une activité...">
        </div>
    </div>

    {# Tableau responsive #}
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th class="px-6 py-3">Icône</th>
                    <th class="px-6 py-3">Titre</th>
                    <th class="px-6 py-3 hidden lg:table-cell">Résumé</th>
                    <th class="px-6 py-3">Date</th>
                    <th class="px-6 py-3 hidden md:table-cell">Lieu</th>
                    <th class="px-6 py-3">Statut</th>
                    <th class="px-6 py-3 hidden sm:table-cell">Participants</th>
                    <th class="px-6 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                {% for a_activity in a_activities %}
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition cursor-pointer" onclick="window.location='{{ path('app_a_activity_show', {'id': a_activity.id}) }}'">
                    <td class="px-6 py-4 text-2xl">
                        {{ a_activity.imageIcon ?: '📌' }}
                    </td>
                    <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                        {{ a_activity.title|slice(0, 50) }}{{ a_activity.title|length > 50 ? '...' : '' }}
                    </td>
                    <td class="px-6 py-4 hidden lg:table-cell max-w-xs truncate">
                        {{ a_activity.resume|slice(0, 60) }}{{ a_activity.resume|length > 60 ? '...' : '' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ a_activity.date ? a_activity.date|date('d/m/Y') : '-' }}
                    </td>
                    <td class="px-6 py-4 hidden md:table-cell">
                        {{ a_activity.lieu|slice(0, 30) }}
                    </td>
                    <td class="px-6 py-4">
                        {% set statusClass = {
                            'en_cours': 'bg-green-100 text-green-700',
                            'planifie': 'bg-blue-100 text-blue-700',
                            'termine': 'bg-gray-100 text-gray-700'
                        } %}
                        <span class="px-2 py-1 text-xs font-semibold rounded-full {{ statusClass[a_activity.status]|default('bg-gray-100 text-gray-700') }}">
                            {% if a_activity.status == 'en_cours' %}
                                <i class="fas fa-play mr-1"></i>En cours
                            {% elseif a_activity.status == 'planifie' %}
                                <i class="fas fa-calendar mr-1"></i>Planifié
                            {% else %}
                                <i class="fas fa-check mr-1"></i>Terminé
                            {% endif %}
                        </span>
                    </td>
                    <td class="px-6 py-4 hidden sm:table-cell">
                        <div class="flex items-center gap-1">
                            <i class="fas fa-users text-gray-400"></i>
                            {{ a_activity.participants }}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-center whitespace-nowrap">
                        <div class="flex justify-center gap-2" onclick="event.stopPropagation()">
                            <a href="{{ path('app_a_activity_show', {'id': a_activity.id}) }}" 
                               class="text-blue-600 hover:text-blue-800 dark:text-blue-400 p-1.5 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 transition"
                               title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_a_activity_edit', {'id': a_activity.id}) }}" 
                               class="text-amber-600 hover:text-amber-800 dark:text-amber-400 p-1.5 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/30 transition"
                               title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" 
                                    onclick="confirmDelete({{ a_activity.id }}, '{{ a_activity.title|e('js') }}')"
                                    class="text-red-600 hover:text-red-800 dark:text-red-400 p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/30 transition"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                        <i class="fas fa-inbox text-4xl mb-3 block"></i>
                        Aucune activité trouvée
                        <div class="mt-3">
                            <a href="{{ path('app_a_activity_new') }}" class="text-amber-600 hover:underline">
                                Créer la première activité →
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if a_activities is defined and a_activities|length > 10 %}
    <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700">
        <nav class="flex justify-between items-center">
            <span class="text-sm text-gray-500 dark:text-gray-400">
                Affichage de <span class="font-semibold">1</span> à <span class="font-semibold">{{ a_activities|length }}</span> sur <span class="font-semibold">{{ a_activities|length }}</span> activités
            </span>
            <div class="flex gap-1">
                <button disabled class="px-3 py-1 text-gray-400 bg-gray-100 rounded-lg cursor-not-allowed">Précédent</button>
                <button class="px-3 py-1 text-white bg-amber-500 rounded-lg">1</button>
                <button class="px-3 py-1 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">Suivant</button>
            </div>
        </nav>
    </div>
    {% endif %}
</div>

{# Modal de confirmation de suppression #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage">
                Êtes-vous sûr de vouloir supprimer cette activité ?
            </p>
            <form id="deleteForm" method="post" style="display: inline;">
                <input type="hidden" name="_token" value="">
                <div class="flex gap-3 justify-center">
                    <button type="button" onclick="closeDeleteModal()" 
                            class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">
                        Annuler
                    </button>
                    <button type="submit" 
                            class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                        Supprimer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Recherche
    document.getElementById('searchInput')?.addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const title = row.querySelector('td:nth-child(2)')?.innerText.toLowerCase() || '';
            const lieu = row.querySelector('td:nth-child(5)')?.innerText.toLowerCase() || '';
            row.style.display = title.includes(searchTerm) || lieu.includes(searchTerm) ? '' : 'none';
        });
    });

    // Suppression modale
    let deleteUrl = '';
    function confirmDelete(id, title) {
        deleteUrl = "{{ path('app_a_activity_delete', {'id': 0}) }}".replace('0', id);
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer l'activité <strong>"${title}"</strong> ? Cette action est irréversible.`;
        document.getElementById('deleteForm').action = deleteUrl;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
    }

    // Fermer la modale en cliquant en dehors
    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>
{% endblock %}