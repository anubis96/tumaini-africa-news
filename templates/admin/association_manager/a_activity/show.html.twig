{% extends 'admin/association_manager/layout.html.twig' %}

{% block association_title %}Activités - Association{% endblock %}

{% block association_content %}
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    {# En-tête avec image #}
    <div class="relative h-48 bg-orange-500">
        {% if a_activity.imageUrl %}
            <img src="{{ vich_uploader_asset(a_activity, 'imageFile') }}" 
                 alt="{{ a_activity.title }}" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/30"></div>
        {% endif %}
        <div class="absolute bottom-4 left-6 flex items-center gap-4">
            <div class="text-6xl drop-shadow-lg">{{ a_activity.imageIcon ?: '📌' }}</div>
            <div>
                <h1 class="text-2xl font-bold text-white drop-shadow-md">{{ a_activity.title }}</h1>
                <p class="text-amber-100 drop-shadow-sm mt-1">{{ a_activity.resume }}</p>
            </div>
        </div>
    </div>

    {# Contenu #}
    <div class="p-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {# Colonne gauche - Infos clés #}
            <div class="lg:col-span-2 space-y-6">
                {# Description #}
                <div>
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2">
                        <i class="fas fa-align-left text-amber-500"></i>
                        Description
                    </h3>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                        <p class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{{ a_activity.description }}</p>
                    </div>
                </div>

                {# Bénéficiaires #}
                {% if a_activity.beneficiaires %}
                <div>
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2">
                        <i class="fas fa-hand-holding-heart text-amber-500"></i>
                        Bénéficiaires
                    </h3>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                        <p class="text-gray-700 dark:text-gray-300">{{ a_activity.beneficiaires }}</p>
                    </div>
                </div>
                {% endif %}
            </div>

            {# Colonne droite - Informations #}
            <div class="space-y-4">
                {# Carte d'informations #}
                <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle text-amber-500"></i>
                        Informations
                    </h4>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-calendar mr-2 text-amber-500"></i>Date
                            </span>
                            <span class="font-medium text-gray-800 dark:text-white">
                                {{ a_activity.date ? a_activity.date|date('d/m/Y') : '-' }}
                            </span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-map-marker-alt mr-2 text-amber-500"></i>Lieu
                            </span>
                            <span class="font-medium text-gray-800 dark:text-white">{{ a_activity.lieu }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-users mr-2 text-amber-500"></i>Participants
                            </span>
                            <span class="font-medium text-gray-800 dark:text-white">{{ a_activity.participants }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-tag mr-2 text-amber-500"></i>Statut
                            </span>
                            {% set statusClass = {
                                'en_cours': 'bg-green-100 text-green-700',
                                'planifie': 'bg-blue-100 text-blue-700',
                                'termine': 'bg-gray-100 text-gray-700'
                            } %}
                            <span class="px-2 py-1 text-xs font-semibold rounded-full {{ statusClass[a_activity.status]|default('bg-gray-100 text-gray-700') }}">
                                {% if a_activity.status == 'en_cours' %}
                                    <i class="fas fa-play mr-1"></i>En cours
                                {% elseif a_activity.status == 'planifie' %}
                                    <i class="fas fa-calendar mr-1"></i>Planifié
                                {% else %}
                                    <i class="fas fa-check mr-1"></i>Terminé
                                {% endif %}
                            </span>
                        </div>
                        {% if a_activity.categories %}
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-folder mr-2 text-amber-500"></i>Catégorie
                            </span>
                            <span class="px-2 py-1 text-xs bg-amber-100 text-amber-700 rounded-full">
                                {{ a_activity.categories.name ?? a_activity.categories.id }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                {# Image de l'activité #}
                {% if a_activity.imageUrl %}
                <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-800 dark:text-white mb-3 flex items-center gap-2">
                        <i class="fas fa-image text-amber-500"></i>
                        Image de l'activité
                    </h4>
                    <img src="{{ vich_uploader_asset(a_activity, 'imageFile') }}" 
                         alt="{{ a_activity.title }}" 
                         class="w-full rounded-lg shadow-md">
                </div>
                {% endif %}
            </div>
        </div>

        {# Actions #}
        <div class="flex flex-wrap justify-between items-center gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <a href="{{ path('app_a_activity_index') }}" 
               class="px-5 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition flex items-center gap-2">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <div class="flex gap-3">
                <a href="{{ path('app_a_activity_edit', {'id': a_activity.id}) }}" 
                   class="px-5 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                    <i class="fas fa-edit"></i> Modifier
                </a>
                <button type="button" 
                        onclick="confirmDelete({{ a_activity.id }}, '{{ a_activity.title|e('js') }}')"
                        class="px-5 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition flex items-center gap-2">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

{# Formulaire de suppression caché #}
<form id="deleteForm" method="post" action="" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a_activity.id) }}" id="deleteToken">
</form>

{# Modal de confirmation #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage">
                Êtes-vous sûr de vouloir supprimer cette activité ?
            </p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeDeleteModal()" 
                        class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">
                    Annuler
                </button>
                <button type="button" onclick="submitDelete()" 
                        class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                    Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteId = null;
    
    function confirmDelete(id, title) {
        deleteId = id;
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer l'activité <strong>"${title}"</strong> ? Cette action est irréversible.`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
        deleteId = null;
    }

    function submitDelete() {
        if (deleteId) {
            const form = document.getElementById('deleteForm');
            form.action = "{{ path('app_a_activity_delete', {'id': 0}) }}".replace('0', deleteId);
            form.submit();
        }
    }

    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>
{% endblock %}