{# templates/admin/association_manager/a_category/_form.html.twig #}
{# On vérifie d'abord si la variable 'form' existe #}
{% if form is defined %}
    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        {# Erreurs du formulaire #}
        {% if form_errors(form) %}
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded" role="alert">
                <p class="font-bold">Erreur</p>
                <p>{{ form_errors(form) }}</p>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {# Colonne gauche #}
            <div class="space-y-5">
                {# Nom #}
                <div>
                    {{ form_label(form.name, 'Nom de la catégorie', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': 'Ex: Éducation, Santé, Agriculture'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                {# Icône #}
                <div>
                    {{ form_label(form.icon, 'Icône', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    {{ form_widget(form.icon, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': '📚, 🛡️, 🌱, 🏥'}}) }}
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Utilisez un emoji ou une icône FontAwesome (ex: 📚)</p>
                    {{ form_errors(form.icon) }}
                </div>

                {# Couleur #}
                <div>
                    {{ form_label(form.couleur, 'Couleur', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    <div class="flex gap-3">
                        {{ form_widget(form.couleur, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': '#F59E0B'}}) }}
                        <div class="w-12 h-10 rounded-lg border border-gray-300" id="colorPreview" style="background-color: #F59E0B"></div>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Code hexadécimal (ex: #F59E0B, #10B981, #3B82F6)</p>
                    {{ form_errors(form.couleur) }}
                </div>
            </div>

            {# Colonne droite #}
            <div class="space-y-5">
                {# Description #}
                <div>
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'rows': 4, 'placeholder': 'Description de la catégorie...'}}) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>
        </div>

        {# Aperçu en direct #}
        <div class="bg-gray-50 dark:bg-gray-700/30 rounded-lg p-4">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Aperçu</h4>
            <div class="flex items-center gap-3" id="preview">
                <div class="text-3xl" id="previewIcon">📚</div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-1 text-xs font-semibold rounded-full" id="previewBadge" style="background-color: #F59E0B; color: white">Nom catégorie</span>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" id="previewDescription">Description de la catégorie</p>
                </div>
            </div>
        </div>

        {# Boutons d'action #}
        <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
            <a href="{{ path('app_a_category_index') }}" 
               class="px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600">
                <i class="fas fa-arrow-left mr-2"></i>Retour
            </a>
            <button type="submit" 
                    class="px-6 py-2 bg-orange-500 text-white rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
                <i class="fas fa-save"></i>
                {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    {{ form_end(form) }}
{% else %}
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded" role="alert">
        <p class="font-bold">Erreur technique</p>
        <p>Le formulaire n'a pas été correctement initialisé.</p>
    </div>
{% endif %}

<script>
    // Aperçu en temps réel - attendre que le DOM soit chargé
    document.addEventListener('DOMContentLoaded', function() {
        const nameInput = document.querySelector('input[id$="_name"]');
        const iconInput = document.querySelector('input[id$="_icon"]');
        const colorInput = document.querySelector('input[id$="_color"]');
        const descriptionInput = document.querySelector('textarea[id$="_description"]');
        const previewIcon = document.getElementById('previewIcon');
        const previewBadge = document.getElementById('previewBadge');
        const previewDescription = document.getElementById('previewDescription');
        const colorPreview = document.getElementById('colorPreview');

        function updatePreview() {
            if (iconInput && iconInput.value) {
                previewIcon.textContent = iconInput.value;
            } else {
                previewIcon.textContent = '📚';
            }
            
            if (nameInput && nameInput.value) {
                previewBadge.textContent = nameInput.value;
            } else {
                previewBadge.textContent = 'Nom catégorie';
            }
            
            if (colorInput && colorInput.value) {
                previewBadge.style.backgroundColor = colorInput.value;
                previewBadge.style.color = getContrastColor(colorInput.value);
                if (colorPreview) colorPreview.style.backgroundColor = colorInput.value;
            } else {
                previewBadge.style.backgroundColor = '#F59E0B';
                previewBadge.style.color = 'white';
            }
            
            if (descriptionInput && descriptionInput.value) {
                previewDescription.textContent = descriptionInput.value;
            } else {
                previewDescription.textContent = 'Description de la catégorie';
            }
        }

        function getContrastColor(hexcolor) {
            // Convertir hex en RGB
            let r, g, b;
            if (hexcolor && hexcolor.startsWith('#')) {
                r = parseInt(hexcolor.slice(1, 3), 16);
                g = parseInt(hexcolor.slice(3, 5), 16);
                b = parseInt(hexcolor.slice(5, 7), 16);
            } else {
                return 'white';
            }
            const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
            return luminance > 0.5 ? 'black' : 'white';
        }

        if (nameInput) nameInput.addEventListener('input', updatePreview);
        if (iconInput) iconInput.addEventListener('input', updatePreview);
        if (colorInput) colorInput.addEventListener('input', updatePreview);
        if (descriptionInput) descriptionInput.addEventListener('input', updatePreview);
        
        updatePreview();
    });
</script>