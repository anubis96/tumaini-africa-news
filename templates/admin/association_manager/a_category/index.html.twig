{% extends 'admin/association_manager/layout.html.twig' %}

{% block association_title %}Catégories - Association{% endblock %}

{% block association_content %}
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    {# En-tête avec actions #}
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h2 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                <i class="fas fa-tags text-amber-500"></i>
                Gestion des catégories
            </h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                {{ categories|length }} catégorie(s) au total
            </p>
        </div>
        <a href="{{ path('app_a_category_new') }}" 
           class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 py-2.5 rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <i class="fas fa-plus"></i>
            Nouvelle catégorie
        </a>
    </div>

    {# Barre de recherche #}
    <div class="px-6 py-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="searchInput" 
                   class="w-full sm:w-80 pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                   placeholder="Rechercher une catégorie...">
        </div>
    </div>

    {# Tableau responsive #}
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th class="px-6 py-3">Icône</th>
                    <th class="px-6 py-3">Nom</th>
                    <th class="px-6 py-3 hidden md:table-cell">Description</th>
                    <th class="px-6 py-3">Couleur</th>
                    <th class="px-6 py-3 text-center">Nb activités</th>
                    <th class="px-6 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                {% for category in categories %}
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition cursor-pointer" onclick="window.location='{{ path('app_a_category_show', {'id': category.id}) }}'">
                    <td class="px-6 py-4 text-2xl">
                        {{ category.icon ?: '📁' }}
                    </td>
                    <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                        {{ category.name }}
                    </td>
                    <td class="px-6 py-4 hidden md:table-cell max-w-xs truncate">
                        {{ category.description|slice(0, 60) }}{{ category.description|length > 60 ? '...' : '' }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full" style="background-color: {{ category.couleur }}"></div>
                            <span class="text-xs text-gray-600 dark:text-gray-400">{{ category.couleur }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-700">
                            {{ category.aActivities|length }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-center whitespace-nowrap">
                        <div class="flex justify-center gap-2" onclick="event.stopPropagation()">
                            <a href="{{ path('app_a_category_show', {'id': category.id}) }}" 
                               class="text-blue-600 hover:text-blue-800 dark:text-blue-400 p-1.5 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 transition"
                               title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_a_category_edit', {'id': category.id}) }}" 
                               class="text-amber-600 hover:text-amber-800 dark:text-amber-400 p-1.5 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/30 transition"
                               title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" 
                                    onclick="confirmDelete({{ category.id }}, '{{ category.name|e('js') }}')"
                                    class="text-red-600 hover:text-red-800 dark:text-red-400 p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/30 transition"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                        <i class="fas fa-folder-open text-4xl mb-3 block"></i>
                        Aucune catégorie trouvée
                        <div class="mt-3">
                            <a href="{{ path('app_a_category_new') }}" class="text-amber-600 hover:underline">
                                Créer la première catégorie →
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Modal de confirmation de suppression #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage">
                Êtes-vous sûr de vouloir supprimer cette catégorie ?
            </p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeDeleteModal()" 
                        class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">
                    Annuler
                </button>
                <button type="button" onclick="submitDelete()" 
                        class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                    Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" style="display: none;">
    <input type="hidden" name="_token" value="" id="deleteToken">
</form>

<script>
    let deleteId = null;
    
    function confirmDelete(id, name) {
        deleteId = id;
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer la catégorie <strong>"${name}"</strong> ? Les activités associées ne seront pas supprimées mais n'auront plus de catégorie.`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
        deleteId = null;
    }

    function submitDelete() {
        if (deleteId) {
            const form = document.getElementById('deleteForm');
            form.action = "{{ path('app_a_category_delete', {'id': 0}) }}".replace('0', deleteId);
            document.getElementById('deleteToken').value = "{{ csrf_token('delete' ~ 0) }}".replace('0', deleteId);
            form.submit();
        }
    }

    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });

    // Recherche
    document.getElementById('searchInput')?.addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            if (row.cells && row.cells.length > 0) {
                const name = row.cells[1]?.innerText.toLowerCase() || '';
                const description = row.cells[2]?.innerText.toLowerCase() || '';
                row.style.display = name.includes(searchTerm) || description.includes(searchTerm) ? '' : 'none';
            }
        });
    });
</script>
{% endblock %}