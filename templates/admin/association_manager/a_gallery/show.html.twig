{# templates/admin/association_manager/a_gallery/show.html.twig #}
{% extends 'admin/association_manager/layout.html.twig' %}

{% block association_title %}Galerie : {{ a_gallery.title }} - Association{% endblock %}

{% block association_content %}
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    {# En-tête #}
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-amber-50 to-orange-50 dark:from-gray-800 dark:to-gray-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <div class="flex items-center gap-3">
                <i class="fas fa-images text-2xl text-amber-500"></i>
                <h1 class="text-2xl font-bold text-gray-800 dark:text-white">{{ a_gallery.title }}</h1>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                <i class="fas fa-calendar-alt mr-1"></i>
                Créé le {{ a_gallery.createdAt ? a_gallery.createdAt|date('d/m/Y à H:i') : 'Date inconnue' }}
                {% if a_gallery.updatedAt %}
                    • Modifié le {{ a_gallery.updatedAt|date('d/m/Y à H:i') }}
                {% endif %}
            </p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_a_gallery_edit', {'id': a_gallery.id}) }}" 
               class="bg-amber-500 text-white px-4 py-2 rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Modifier
            </a>
            <a href="{{ path('app_a_gallery_index') }}" 
               class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition flex items-center gap-2">
                <i class="fas fa-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>

    {# Corps #}
    <div class="p-6 space-y-6">
        {# Description #}
        {% if a_gallery.description %}
        <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-2 flex items-center gap-2">
                <i class="fas fa-align-left text-amber-500"></i>
                Description
            </h3>
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{{ a_gallery.description }}</p>
        </div>
        {% endif %}

        {# Informations #}
        <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-2 flex items-center gap-2">
                <i class="fas fa-info-circle text-amber-500"></i>
                Informations
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">ID</span>
                    <p class="font-medium text-gray-900 dark:text-white">{{ a_gallery.id }}</p>
                </div>
                <div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">Nombre d'images</span>
                    <p class="font-medium text-gray-900 dark:text-white">
                        {{ a_gallery.imageNames|length }} image(s)
                    </p>
                </div>
            </div>
        </div>

        {# Galerie d'images #}
        <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center gap-2">
                <i class="fas fa-images text-amber-500"></i>
                Images de l'album
            </h3>
            
            {% if a_gallery.imageNames|length > 0 %}
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    {% for imageName in a_gallery.imageNames %}
                        <div class="relative group">
                            <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-700">
                                <img src="{{ '/images/gallery/' ~ imageName }}" 
                                     alt="Image {{ loop.index }}"
                                     class="w-full h-full object-cover cursor-pointer transition transform group-hover:scale-105"
                                     onclick="openModal('{{ '/images/gallery/' ~ imageName }}', '{{ a_gallery.title }} - Image {{ loop.index }}')">
                            </div>
                            <div class="absolute top-2 right-2">
                                <span class="bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-full">
                                    {{ loop.index }}
                                </span>
                            </div>
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-2 opacity-0 group-hover:opacity-100 transition">
                                <button onclick="openModal('{{ '/images/gallery/' ~ imageName }}', '{{ a_gallery.title }} - Image {{ loop.index }}')"
                                        class="text-white text-xs flex items-center justify-center gap-1 w-full">
                                    <i class="fas fa-search-plus"></i> Agrandir
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-12 bg-gray-50 dark:bg-gray-900 rounded-lg">
                    <i class="fas fa-camera text-5xl text-gray-400 mb-3 block"></i>
                    <p class="text-gray-500 dark:text-gray-400">Aucune image dans cet album</p>
                    <a href="{{ path('app_a_gallery_edit', {'id': a_gallery.id}) }}" 
                       class="inline-block mt-3 text-amber-500 hover:underline">
                        <i class="fas fa-plus mr-1"></i>Ajouter des images
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    {# Footer avec action de suppression #}
    <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 flex justify-between items-center">
        <div class="text-sm text-gray-500">
            <i class="fas fa-info-circle"></i>
            Dernière modification : {{ a_gallery.updatedAt ? a_gallery.updatedAt|date('d/m/Y H:i:s') : a_gallery.createdAt|date('d/m/Y H:i:s') }}
        </div>
        <button onclick="confirmDelete()" 
                class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition flex items-center gap-2">
            <i class="fas fa-trash"></i>
            Supprimer l'album
        </button>
    </div>
</div>

{# Modal pour agrandir les images #}
<div id="imageModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90" onclick="closeModal()">
    <div class="relative max-w-5xl w-full mx-4" onclick="event.stopPropagation()">
        <button onclick="closeModal()" class="absolute -top-12 right-0 text-white hover:text-amber-400 text-3xl">
            <i class="fas fa-times"></i>
        </button>
        <img id="modalImage" src="" alt="" class="w-full h-auto max-h-[80vh] object-contain rounded-lg">
        <div id="modalCaption" class="text-center text-white mt-4 text-sm"></div>
        <div class="absolute left-4 top-1/2 -translate-y-1/2">
            <button id="prevImage" class="bg-black/50 text-white p-3 rounded-full hover:bg-black/75">
                <i class="fas fa-chevron-left text-xl"></i>
            </button>
        </div>
        <div class="absolute right-4 top-1/2 -translate-y-1/2">
            <button id="nextImage" class="bg-black/50 text-white p-3 rounded-full hover:bg-black/75">
                <i class="fas fa-chevron-right text-xl"></i>
            </button>
        </div>
    </div>
</div>

{# Formulaire de suppression caché #}
<form id="deleteForm" method="post" action="{{ path('app_a_gallery_delete', {'id': a_gallery.id}) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a_gallery.id) }}">
</form>

{# Scripts #}
<script>
// Modal pour agrandir les images
let currentImages = [];
let currentIndex = 0;

{% if a_gallery.imageNames|length > 0 %}
    currentImages = [
        {% for imageName in a_gallery.imageNames %}
            { url: '{{ '/images/gallery/' ~ imageName }}', caption: '{{ a_gallery.title }} - Image {{ loop.index }}' },
        {% endfor %}
    ];
{% endif %}

function openModal(url, caption) {
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    const modalCaption = document.getElementById('modalCaption');
    
    // Trouver l'index de l'image
    currentIndex = currentImages.findIndex(img => img.url === url);
    
    modalImg.src = url;
    modalCaption.innerHTML = caption;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
}

function navigateImage(direction) {
    if (currentImages.length === 0) return;
    
    currentIndex += direction;
    if (currentIndex < 0) currentIndex = currentImages.length - 1;
    if (currentIndex >= currentImages.length) currentIndex = 0;
    
    const image = currentImages[currentIndex];
    document.getElementById('modalImage').src = image.url;
    document.getElementById('modalCaption').innerHTML = image.caption;
}

// Navigation au clavier
document.addEventListener('keydown', function(e) {
    const modal = document.getElementById('imageModal');
    if (!modal.classList.contains('hidden')) {
        if (e.key === 'ArrowLeft') {
            navigateImage(-1);
        } else if (e.key === 'ArrowRight') {
            navigateImage(1);
        } else if (e.key === 'Escape') {
            closeModal();
        }
    }
});

// Boutons de navigation
const prevBtn = document.getElementById('prevImage');
const nextBtn = document.getElementById('nextImage');
if (prevBtn) prevBtn.onclick = () => navigateImage(-1);
if (nextBtn) nextBtn.onclick = () => navigateImage(1);

// Confirmation de suppression
function confirmDelete() {
    if (confirm('Êtes-vous sûr de vouloir supprimer cet album ? Cette action est irréversible.')) {
        document.getElementById('deleteForm').submit();
    }
}
</script>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
{% endblock %}