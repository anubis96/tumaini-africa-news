{# Ce formulaire est utilisé dans edit.html.twig comme zone dangereuse #}
<div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
    <h3 class="text-sm font-medium text-red-600 dark:text-red-400 mb-3 flex items-center gap-2">
        <i class="fas fa-exclamation-triangle"></i>
        Zone dangereuse
    </h3>
    <form method="post" action="{{ path('app_a_membre_delete', {'id': a_membre.id}) }}" 
          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce membre ? Cette action est irréversible.');"
          class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a_membre.id) }}">
        <button type="submit" 
                class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition flex items-center gap-2">
            <i class="fas fa-trash"></i>
            Supprimer le membre
        </button>
    </form>
</div>