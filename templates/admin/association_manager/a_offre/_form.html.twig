{# templates/admin/association_manager/a_offre/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    {% if form_errors(form) %}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded" role="alert">
            <p class="font-bold">Erreur</p>
            <p>{{ form_errors(form) }}</p>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {# Colonne gauche #}
        <div class="space-y-5">
            {# Titre #}
            <div>
                {{ form_label(form.titre, 'Titre de l\'offre', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            {# Résumé #}
            <div>
                {{ form_label(form.resume, 'Résumé', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.resume, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'rows': 2}}) }}
                {{ form_errors(form.resume) }}
            </div>

            {# Description #}
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'rows': 5}}) }}
                {{ form_errors(form.description) }}
            </div>

            {# Compétences #}
            <div>
                {{ form_label(form.compentences, 'Compétences', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.compentences, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': 'Gestion de projets, Leadership, Communication'}}) }}
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Séparez les compétences par des virgules</p>
                {{ form_errors(form.compentences) }}
            </div>
        </div>

        {# Colonne droite #}
        <div class="space-y-5">
            {# Type de contrat #}
            <div>
                {{ form_label(form.type, 'Type de contrat', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white'}}) }}
                {{ form_errors(form.type) }}
            </div>

            {# Lieu #}
            <div>
                {{ form_label(form.lieu, 'Lieu', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.lieu, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white'}}) }}
                {{ form_errors(form.lieu) }}
            </div>

            {# Date limite #}
            <div>
                {{ form_label(form.dateLimite, 'Date limite', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.dateLimite, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white'}}) }}
                {{ form_errors(form.dateLimite) }}
            </div>

            {# Expérience #}
            <div>
                {{ form_label(form.experience, 'Expérience requise', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.experience, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': '3 ans minimum'}}) }}
                {{ form_errors(form.experience) }}
            </div>

            {# Formation #}
            <div>
                {{ form_label(form.formation, 'Formation requise', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.formation, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': 'Bac+3 en Gestion'}}) }}
                {{ form_errors(form.formation) }}
            </div>

            {# Statut #}
            <div>
                {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white'}}) }}
                {{ form_errors(form.statut) }}
            </div>

            {# Icône #}
            <div>
                {{ form_label(form.icon, 'Icône', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                {{ form_widget(form.icon, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white', 'placeholder': '🏥'}}) }}
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Emoji représentant l'offre</p>
                {{ form_errors(form.icon) }}
            </div>
        </div>
    </div>

    {# Boutons d'action #}
    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
        <a href="{{ path('app_a_offre_index') }}" 
           class="px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600">
            <i class="fas fa-arrow-left mr-2"></i>Retour
        </a>
        <button type="submit" 
                class="px-6 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <i class="fas fa-save"></i>
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}