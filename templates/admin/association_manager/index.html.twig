{# templates/association/dashboard.html.twig #}
{% extends 'association_manager/layout.html.twig' %}

{% block association_title %}Tableau de bord - Association{% endblock %}

{% block association_content %}
{# Statistiques #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Activités</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ stats.activites_total }}</p>
                <div class="flex items-center mt-2">
                    <span class="text-xs text-green-500">
                        <i class="fas fa-arrow-up"></i> +{{ stats.activites_this_month }}
                    </span>
                    <span class="text-xs text-gray-400 ml-2">ce mois</span>
                </div>
            </div>
            <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
        </div>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Offres Actives</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ stats.offres_actives }}</p>
                <div class="flex items-center mt-2">
                    <span class="text-xs text-orange-500">
                        <i class="fas fa-clock"></i> {{ stats.offres_expire_bientot }} expirent bientôt
                    </span>
                </div>
            </div>
            <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/30 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
            </div>
        </div>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Membres</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ stats.membres_total }}</p>
                <div class="flex items-center mt-2">
                    <span class="text-xs text-green-500">
                        <i class="fas fa-user-plus"></i> +{{ stats.membres_nouveaux }}
                    </span>
                    <span class="text-xs text-gray-400 ml-2">cette année</span>
                </div>
            </div>
            <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
            </div>
        </div>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Participants</p>
                <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ stats.participants_total }}</p>
                <div class="flex items-center mt-2">
                    <span class="text-xs text-gray-500">Toutes activités confondues</span>
                </div>
            </div>
            <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

{# Graphiques et sections #}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    {# Statut des activités #}
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Activités par statut</h3>
        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">En cours</span>
                    <span class="font-semibold text-green-600">{{ stats.activites_en_cours }}</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div class="bg-green-500 h-2 rounded-full" style="width: {{ stats.activites_total > 0 ? (stats.activites_en_cours / stats.activites_total * 100) : 0 }}%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">Planifiées</span>
                    <span class="font-semibold text-blue-600">{{ stats.activites_planifiees }}</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div class="bg-blue-500 h-2 rounded-full" style="width: {{ stats.activites_total > 0 ? (stats.activites_planifiees / stats.activites_total * 100) : 0 }}%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 dark:text-gray-400">Terminées</span>
                    <span class="font-semibold text-gray-600">{{ stats.activites_terminees }}</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div class="bg-gray-500 h-2 rounded-full" style="width: {{ stats.activites_total > 0 ? (stats.activites_terminees / stats.activites_total * 100) : 0 }}%"></div>
                </div>
            </div>
        </div>
    </div>
    
    {# Actions rapides #}
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Actions rapides</h3>
        <div class="space-y-3">
            <a href="{{ path('app_association_activite_new') }}" 
               class="flex items-center gap-3 p-3 bg-orange-500 text-white rounded-lg hover:shadow-lg transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Nouvelle activité</span>
            </a>
            <a href="{{ path('app_association_offre_new') }}" 
               class="flex items-center gap-3 p-3 bg-orange-600 text-white rounded-lg hover:shadow-lg transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Nouvelle offre d'emploi</span>
            </a>
            <a href="{{ path('app_association_membre_new') }}" 
               class="flex items-center gap-3 p-3 bg-orange-700 text-white rounded-lg hover:shadow-lg transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
                <span>Nouveau membre</span>
            </a>
        </div>
    </div>
    
    {# Offres récentes #}
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white">Offres récentes</h3>
            <a href="{{ path('app_association_offre_index') }}" class="text-sm text-amber-600 hover:underline">Voir tout →</a>
        </div>
        <div class="space-y-3">
            {% for offre in offres_recentes %}
                <div class="flex items-center justify-between p-2 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">{{ offre.icon }}</span>
                        <div>
                            <p class="text-sm font-medium text-gray-800 dark:text-white">{{ offre.titre|slice(0, 35) }}{% if offre.titre|length > 35 %}...{% endif %}</p>
                            <p class="text-xs text-gray-500">{{ offre.lieu }}</p>
                        </div>
                    </div>
                    <span class="text-xs px-2 py-1 rounded-full {{ offre.statut == 'ouvert' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' }}">
                        {{ offre.statut }}
                    </span>
                </div>
            {% else %}
                <p class="text-center text-gray-500 py-4">Aucune offre pour le moment</p>
            {% endfor %}
        </div>
    </div>
</div>

{# Dernières activités #}
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white">Dernières activités</h3>
        <a href="{{ path('app_association_activite_index') }}" class="text-sm text-amber-600 hover:underline">Voir toutes →</a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th class="px-5 py-3">Titre</th>
                    <th class="px-5 py-3">Catégorie</th>
                    <th class="px-5 py-3">Date</th>
                    <th class="px-5 py-3">Lieu</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="px-5 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for activite in activites_recentes %}
                    <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                        <td class="px-5 py-3 font-medium text-gray-900 dark:text-white">{{ activite.titre|slice(0, 50) }}{% if activite.titre|length > 50 %}...{% endif %}</td>
                        <td class="px-5 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-amber-100 text-amber-700">{{ activite.categorie.nom }}</span>
                        </td>
                        <td class="px-5 py-3">{{ activite.date|date('d/m/Y') }}</td>
                        <td class="px-5 py-3">{{ activite.lieu }}</td>
                        <td class="px-5 py-3">
                            <span class="px-2 py-1 text-xs rounded-full 
                                {{ activite.status == 'en_cours' ? 'bg-green-100 text-green-700' : 
                                   activite.status == 'termine' ? 'bg-gray-100 text-gray-700' : 
                                   'bg-blue-100 text-blue-700' }}">
                                {{ activite.status }}
                            </span>
                        </td>
                        <td class="px-5 py-3">
                            <div class="flex gap-2">
                                <a href="{{ path('app_association_activite_show', {'id': activite.id}) }}" class="text-blue-600 hover:text-blue-800">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                </a>
                                <a href="{{ path('app_association_activite_edit', {'id': activite.id}) }}" class="text-amber-600 hover:text-amber-800">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-5 py-8 text-center text-gray-500">Aucune activité pour le moment</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}