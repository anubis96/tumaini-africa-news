<form method="post" action="{{ path('app_audio_delete', {'id': audio.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ audio.id) }}">
    <button class="btn bg-red-700 p-2 rounded-lg text-white hover:bg-red-900">Supprimer</button>
</form>
