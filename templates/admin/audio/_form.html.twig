{# templates/admin/audio/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    
    {% if form_errors(form) %}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
            {{ form_errors(form) }}
        </div>
    {% endif %}

    <div class="grid gap-6">
        {# Titre #}
        <div>
            {{ form_label(form.title, 'Titre du podcast', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'placeholder': 'Entrez le titre du podcast'}}) }}
            {{ form_errors(form.title) }}
        </div>

        {# Description #}
        <div>
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white', 'rows': 4, 'placeholder': 'Description du podcast...'}}) }}
            {{ form_errors(form.description) }}
        </div>

        {# Catégorie #}
        <div>
            {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.category, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white'}}) }}
            {{ form_errors(form.category) }}
        </div>

        {# Fichier audio #}
        <div>
            {{ form_label(form.audioFile, 'Fichier audio', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            {{ form_widget(form.audioFile, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100'}}) }}
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">MP3, WAV, OGG (max. 30MB)</p>
            {{ form_errors(form.audioFile) }}
            {% if audio.audioUrl %}
                <div class="mt-2">
                    <p class="text-sm text-gray-600 dark:text-gray-400">Fichier actuel : {{ audio.audioUrl }}</p>
                    <audio controls class="w-full mt-2">
                        <source src="{{ vich_uploader_asset(audio, 'audioFile') }}" type="audio/mpeg">
                    </audio>
                </div>
            {% endif %}
        </div>

        {# Image de couverture #}
        <div>
            {{ form_label(form.coverFile, 'Image de couverture', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
            <div class="flex items-center justify-center w-full">
                <label class="flex flex-col items-center justify-center w-full h-48 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition">
                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                        <svg class="w-8 h-8 mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
                            <span class="font-semibold">Cliquez pour uploader</span> ou glissez-déposez
                        </p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">SVG, PNG, JPG (max. 2MB)</p>
                    </div>
                    {{ form_widget(form.coverFile, {'attr': {'class': 'hidden', 'id': 'coverInput'}}) }}
                </label>
            </div>
            <div id="coverPreview" class="mt-3 {% if not audio.cover %}hidden{% endif %}">
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                <img src="{{ audio.cover ? vich_uploader_asset(audio, 'coverFile') : '' }}" class="max-h-32 rounded-lg" alt="Cover preview">
            </div>
            {{ form_errors(form.coverFile) }}
        </div>
    </div>

    {# Boutons d'action #}
    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
        <a href="{{ path('app_audio_index') }}" 
           class="px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour à la liste
        </a>
        <button type="submit" 
                class="px-6 py-2 bg-orange-500 text-white rounded-lg hover:shadow-lg transition shadow-md flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {{ button_label|default('Enregistrer le podcast') }}
        </button>
    </div>

{{ form_end(form) }}

<script>
    // Preview de l'image de couverture
    const coverInput = document.getElementById('coverInput');
    const coverPreview = document.getElementById('coverPreview');
    
    if (coverInput) {
        coverInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = coverPreview.querySelector('img');
                    if (img) {
                        img.src = event.target.result;
                    } else {
                        coverPreview.innerHTML = `<p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Aperçu :</p>
                                                  <img src="${event.target.result}" class="max-h-32 rounded-lg" alt="Cover preview">`;
                    }
                    coverPreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
    }
</script>