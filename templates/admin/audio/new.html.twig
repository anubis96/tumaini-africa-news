{% extends 'admin/dashboard.html.twig' %}

{% block title %}Nouveau podcast{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-4xl mx-auto">
        {# En-tête #}
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Nouveau podcast
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Créez un nouveau podcast pour votre site</p>
        </div>

        {# Formulaire #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-6">
                {{ include('admin/audio/_form.html.twig', {'button_label': 'Publier le podcast'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}