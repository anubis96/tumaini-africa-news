{% extends 'admin/dashboard.html.twig' %}

{% block title %}Audio | {{ audio.title }}{% endblock %}

{% block in_body %}
<div class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header avec navigation -->
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <a href="{{ path('app_audio_index') }}" 
                           class="text-gray-500 hover:text-amber-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                        </a>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Détails de l'audio</h1>
                    </div>
                    <p class="text-gray-500">Gérez et visualisez les informations de votre contenu audio</p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('app_audio_edit', {'id': audio.id}) }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 transition-all duration-300 shadow-md hover:shadow-lg">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Modifier
                    </a>
                    {{ include('admin/audio/_delete_form.html.twig') }}
                </div>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Colonne de gauche - Image et lecteur -->
            <div class="lg:col-span-1">
                <!-- Card Cover -->
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden sticky top-8">
                    <div class="relative h-64 overflow-hidden">
                        <img src="{{ vich_uploader_asset(audio, 'coverFile') }}" 
                             alt="{{ audio.title }}" 
                             class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                        <div class="absolute bottom-4 left-4 right-4">
                            <span class="inline-flex items-center gap-1 px-2 py-1 bg-amber-500 text-white text-xs font-semibold rounded-lg">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 01.586 1.414V19a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                                </svg>
                                {{ audio.category.name|default('Non catégorisé') }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Lecteur audio</h3>
                            <span class="text-xs text-gray-400">{{ audio.duration }} min</span>
                        </div>
                        
                        <!-- Audio Player amélioré -->
                        <div class="bg-gray-100 rounded-xl p-4">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 flex items-center justify-center shadow-md">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <p class="text-xs text-gray-500">Fichier audio</p>
                                    <p class="text-sm font-medium text-gray-700 truncate">{{ audio.title }}</p>
                                </div>
                            </div>
                            <audio controls class="w-full rounded-lg">
                                <source src="{{ vich_uploader_asset(audio, 'audioFile') }}" type="audio/mpeg">
                                Votre navigateur ne supporte pas l'élément audio.
                            </audio>
                        </div>
                        
                        <!-- Informations rapides -->
                        <div class="mt-6 pt-4 border-t border-gray-100">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-gray-500">ID unique</span>
                                <span class="font-mono text-gray-800">{{ audio.id }}</span>
                            </div>
                            <div class="flex items-center justify-between text-sm mt-2">
                                <span class="text-gray-500">Slug</span>
                                <span class="font-mono text-gray-600 text-xs">{{ audio.slug }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Colonne de droite - Informations détaillées -->
            <div class="lg:col-span-2">
                <!-- Card informations principales -->
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
                    <div class="px-6 py-4 bg-gradient-to-r from-amber-50 to-orange-50 border-b border-amber-100">
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <h2 class="text-lg font-semibold text-gray-800">Informations principales</h2>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Titre</label>
                                <p class="text-gray-900 font-medium">{{ audio.title }}</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Durée</label>
                                <p class="text-gray-900 font-medium">
                                    <span class="inline-flex items-center gap-1">
                                        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        {{ audio.duration }} minutes
                                    </span>
                                </p>
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Description</label>
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <p class="text-gray-700 leading-relaxed">{{ audio.description|nl2br }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Card dates et métadonnées -->
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                    <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <h2 class="text-lg font-semibold text-gray-800">Métadonnées</h2>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-gray-100">
                                <div class="sm:w-1/3">
                                    <span class="text-sm font-medium text-gray-500">Date de publication</span>
                                </div>
                                <div class="sm:w-2/3">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <span class="text-gray-800">{{ audio.publishedAt ? audio.publishedAt|date('l d F Y à H:i') : 'Non publié' }}</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-gray-100">
                                <div class="sm:w-1/3">
                                    <span class="text-sm font-medium text-gray-500">Date de création</span>
                                </div>
                                <div class="sm:w-2/3">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        <span class="text-gray-800">{{ audio.createdAt ? audio.createdAt|date('l d F Y à H:i') : 'N/A' }}</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex flex-col sm:flex-row sm:items-center py-2">
                                <div class="sm:w-1/3">
                                    <span class="text-sm font-medium text-gray-500">Dernière modification</span>
                                </div>
                                <div class="sm:w-2/3">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        <span class="text-gray-800">{{ audio.updatedAt ? audio.updatedAt|date('l d F Y à H:i') : 'N/A' }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Card actions supplémentaires -->
                <div class="mt-8 flex flex-wrap gap-3 justify-end">
                    <button onclick="window.print()" 
                            class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-all duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                        </svg>
                        Imprimer
                    </button>
                    <a href="{{ path('app_audio_edit', {'id': audio.id}) }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 transition-all duration-300 shadow-md">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Modifier l'audio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styles additionnels pour l'audio player */
    audio::-webkit-media-controls-panel {
        background-color: #f3f4f6;
    }
    
    audio::-webkit-media-controls-play-button {
        background-color: #d97706;
        border-radius: 50%;
    }
    
    audio::-webkit-media-controls-play-button:hover {
        background-color: #ea580c;
    }
    
    /* Animation d'entrée */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .bg-white {
        animation: fadeIn 0.3s ease-out;
    }
</style>
{% endblock %}