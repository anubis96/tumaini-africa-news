{# templates/admin/comments/index.html.twig #}

{% extends 'admin/dashboard.html.twig' %}

{% block title %}Modération des commentaires{% endblock %}

{% block in_body %}
<div class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header -->
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Modération des commentaires</h1>
                    <p class="text-gray-500 mt-1">Gérez et modérez les commentaires des visiteurs</p>
                </div>
            </div>
        </div>
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6 mb-8">
            <div class="bg-amber-600 rounded-2xl shadow-lg p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-amber-100 text-sm">En attente</p>
                        <p class="text-3xl font-bold">{{ pending_count }}</p>
                    </div>
                    <svg class="w-12 h-12 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <a href="{{ path('app_admin_comments_index', {'status': 'pending'}) }}" class="mt-4 inline-block text-sm text-amber-100 hover:text-white transition-colors">
                    Voir en attente →
                </a>
            </div>
            
            <div class="bg-emerald-600 rounded-2xl shadow-lg p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">Approuvés</p>
                        <p class="text-3xl font-bold">{{ approved_count }}</p>
                    </div>
                    <svg class="w-12 h-12 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <a href="{{ path('app_admin_comments_index', {'status': 'approved'}) }}" class="mt-4 inline-block text-sm text-green-100 hover:text-white transition-colors">
                    Voir approuvés →
                </a>
            </div>
            
            <div class="bg-rose-600 rounded-2xl shadow-lg p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-red-100 text-sm">Rejetés</p>
                        <p class="text-3xl font-bold">{{ rejected_count }}</p>
                    </div>
                    <svg class="w-12 h-12 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <a href="{{ path('app_admin_comments_index', {'status': 'rejected'}) }}" class="mt-4 inline-block text-sm text-red-100 hover:text-white transition-colors">
                    Voir rejetés →
                </a>
            </div>
            
            <div class="bg-gray-600 rounded-2xl shadow-lg p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-300 text-sm">Total</p>
                        <p class="text-3xl font-bold">{{ total_count }}</p>
                    </div>
                    <svg class="w-12 h-12 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <a href="{{ path('app_admin_comments_index', {'status': 'all'}) }}" class="mt-4 inline-block text-sm text-gray-300 hover:text-white transition-colors">
                    Voir tous →
                </a>
            </div>
        </div>
        
        <!-- Tabs -->
        <div class="mb-6 border-b border-gray-200">
            <ul class="flex flex-wrap -mb-px text-sm font-medium text-center">
                <li class="mr-2">
                    <a href="{{ path('app_admin_comments_index', {'status': 'pending'}) }}" 
                       class="inline-block p-4 rounded-t-lg {% if current_status == 'pending' %}border-b-2 border-amber-600 text-amber-600{% else %}text-gray-500 hover:text-gray-700{% endif %}">
                        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        En attente
                        <span class="ml-1 px-2 py-0.5 text-xs rounded-full {% if current_status == 'pending' %}bg-amber-100 text-amber-600{% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ pending_count }}
                        </span>
                    </a>
                </li>
                <li class="mr-2">
                    <a href="{{ path('app_admin_comments_index', {'status': 'approved'}) }}" 
                       class="inline-block p-4 rounded-t-lg {% if current_status == 'approved' %}border-b-2 border-green-600 text-green-600{% else %}text-gray-500 hover:text-gray-700{% endif %}">
                        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Approuvés
                        <span class="ml-1 px-2 py-0.5 text-xs rounded-full {% if current_status == 'approved' %}bg-green-100 text-green-600{% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ approved_count }}
                        </span>
                    </a>
                </li>
                <li class="mr-2">
                    <a href="{{ path('app_admin_comments_index', {'status': 'rejected'}) }}" 
                       class="inline-block p-4 rounded-t-lg {% if current_status == 'rejected' %}border-b-2 border-red-600 text-red-600{% else %}text-gray-500 hover:text-gray-700{% endif %}">
                        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Rejetés
                        <span class="ml-1 px-2 py-0.5 text-xs rounded-full {% if current_status == 'rejected' %}bg-red-100 text-red-600{% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ rejected_count }}
                        </span>
                    </a>
                </li>
                <li class="mr-2">
                    <a href="{{ path('app_admin_comments_index', {'status': 'all'}) }}" 
                       class="inline-block p-4 rounded-t-lg {% if current_status == 'all' %}border-b-2 border-gray-600 text-gray-600{% else %}text-gray-500 hover:text-gray-700{% endif %}">
                        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                        Tous
                        <span class="ml-1 px-2 py-0.5 text-xs rounded-full {% if current_status == 'all' %}bg-gray-600 text-white{% else %}bg-gray-100 text-gray-600{% endif %}">
                            {{ total_count }}
                        </span>
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Bulk Actions Form -->
        <form method="POST" action="{{ path('app_admin_comments_bulk') }}" id="bulk-form">
            <input type="hidden" name="redirect_status" value="{{ current_status }}">
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="p-4 border-b border-gray-200 bg-gray-50 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <input type="checkbox" id="select-all" class="w-4 h-4 text-amber-600 rounded border-gray-300 focus:ring-amber-500">
                        <span class="text-sm text-gray-600">Sélectionner tout</span>
                    </div>
                    <div class="flex gap-2">
                        <select name="action" id="bulk-action" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                            <option value="">Action groupée</option>
                            <option value="approve">Approuver</option>
                            <option value="reject">Rejeter</option>
                            <option value="delete">Supprimer</option>
                        </select>
                        <button type="submit" class="px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors text-sm">
                            Appliquer
                        </button>
                    </div>
                </div>
                
                <!-- Comments Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-500">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 w-10">
                                    <span class="sr-only">Sélection</span>
                                </th>
                                <th scope="col" class="px-6 py-3">Statut</th>
                                <th scope="col" class="px-6 py-3">Auteur</th>
                                <th scope="col" class="px-6 py-3">Commentaire</th>
                                <th scope="col" class="px-6 py-3">Article</th>
                                <th scope="col" class="px-6 py-3">Date</th>
                                <th scope="col" class="px-6 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for comment in comments %}
                            <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <input type="checkbox" name="comment_ids[]" value="{{ comment.id }}" class="comment-checkbox w-4 h-4 text-amber-600 rounded border-gray-300 focus:ring-amber-500">
                                </td>
                                <td class="px-6 py-4">
                                    {% if comment.isApproved %}
                                        <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            Approuvé
                                        </span>
                                    {% elseif comment.isRejected %}
                                        <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            Rejeté
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 px-2 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-medium">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            En attente
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 flex items-center justify-center text-white font-bold shadow-sm">
                                            {{ comment.firstname|first }}{{ comment.lastname|first }}
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-900">{{ comment.firstname }} {{ comment.lastname }}</p>
                                            <p class="text-xs text-gray-400">{{ comment.phone }}</p>
                                            {% if comment.email %}
                                                <p class="text-xs text-gray-400">{{ comment.email }}</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="max-w-md">
                                        <p class="text-gray-700 line-clamp-2">{{ comment.content|raw }}</p>
                                        <a href="{{ path('app_admin_comments_view', {'id': comment.id}) }}" class="text-xs text-amber-600 hover:text-amber-700">
                                            Voir détail →
                                        </a>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <a href="{{ path('app_single_article_public', {'slug': comment.article.slug}) }}" 
                                       target="_blank"
                                       class="text-gray-700 hover:text-amber-600 transition-colors">
                                        {{ comment.article.title|slice(0, 40) }}...
                                    </a>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm">
                                        <p>{{ comment.createdAt|date('d/m/Y') }}</p>
                                        <p class="text-xs text-gray-400">{{ comment.createdAt|date('H:i') }}</p>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">{{ comment.ipAddress }}</p>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex gap-2">
                                        {# Actions pour les commentaires en attente uniquement #}
                                        {% if not comment.isApproved and not comment.isRejected %}
                                            <form method="POST" action="{{ path('app_admin_comments_approve', {'id': comment.id}) }}" class="inline">
                                                <input type="hidden" name="redirect_status" value="{{ current_status }}">
                                                <button type="submit" class="text-green-600 hover:text-green-700 transition-colors p-1 hover:bg-green-50 rounded" title="Approuver" onclick="return confirm('Approuver ce commentaire ?')">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                </button>
                                            </form>
                                            <form method="POST" action="{{ path('app_admin_comments_reject', {'id': comment.id}) }}" class="inline">
                                                <input type="hidden" name="redirect_status" value="{{ current_status }}">
                                                <button type="submit" class="text-orange-600 hover:text-orange-700 transition-colors p-1 hover:bg-orange-50 rounded" title="Rejeter" onclick="return confirm('Rejeter ce commentaire ?')">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        {% endif %}
                                        
                                        {# Bouton supprimer pour tous #}
                                        <form method="POST" action="{{ path('app_admin_comments_delete', {'id': comment.id}) }}" 
                                              onsubmit="return confirm('Supprimer définitivement ce commentaire ? Cette action est irréversible.')" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                            <input type="hidden" name="redirect_status" value="{{ current_status }}">
                                            <button type="submit" class="text-red-600 hover:text-red-700 transition-colors p-1 hover:bg-red-50 rounded" title="Supprimer">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                    </svg>
                                    <p class="text-gray-500">Aucun commentaire dans cette catégorie</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select all checkboxes
    const selectAllCheckbox = document.getElementById('select-all');
    const commentCheckboxes = document.querySelectorAll('.comment-checkbox');
    
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function(e) {
            commentCheckboxes.forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
        });
    }
    
    // Bulk form validation
    const bulkForm = document.getElementById('bulk-form');
    if (bulkForm) {
        bulkForm.addEventListener('submit', function(e) {
            const actionSelect = document.getElementById('bulk-action');
            const action = actionSelect ? actionSelect.value : '';
            const checkedCount = document.querySelectorAll('.comment-checkbox:checked').length;
            
            if (!action) {
                e.preventDefault();
                alert('Veuillez sélectionner une action');
                return false;
            }
            
            if (checkedCount === 0) {
                e.preventDefault();
                alert('Veuillez sélectionner au moins un commentaire');
                return false;
            }
            
            let message = '';
            switch(action) {
                case 'approve':
                    message = `Approuver ${checkedCount} commentaire(s) ?`;
                    break;
                case 'reject':
                    message = `Rejeter ${checkedCount} commentaire(s) ?`;
                    break;
                case 'delete':
                    message = `Supprimer définitivement ${checkedCount} commentaire(s) ? Cette action est irréversible.`;
                    break;
            }
            
            if (message && !confirm(message)) {
                e.preventDefault();
                return false;
            }
        });
    }
    
    // Désélectionner "Sélectionner tout" si un checkbox est décoché
    commentCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            if (selectAllCheckbox && !this.checked) {
                selectAllCheckbox.checked = false;
            }
            
            // Vérifier si tous sont cochés
            const allChecked = Array.from(commentCheckboxes).every(cb => cb.checked);
            if (selectAllCheckbox && allChecked) {
                selectAllCheckbox.checked = true;
            }
        });
    });
});
</script>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
{% endblock %}