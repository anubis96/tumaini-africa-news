{# templates/admin/comments/view.html.twig #}

{% extends 'admin/dashboard.html.twig' %}

{% block title %}Détail du commentaire{% endblock %}

{% block in_body %}
<div class="bg-gray-50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <div class="mb-6">
            <a href="{{ path('app_admin_comments_index', {'status': app.request.query.get('status', 'pending')}) }}" class="text-amber-600 hover:text-amber-700 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour à la liste
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="bg-orange-600  px-6 py-4">
                <h1 class="text-xl font-bold text-white">Détail du commentaire</h1>
            </div>
            
            <div class="p-6">
                <div class="mb-6 p-4 bg-gray-50 rounded-xl">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">Informations auteur</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <span class="text-sm text-gray-500">Nom complet :</span>
                            <p class="font-medium text-gray-800">{{ comment.firstname }} {{ comment.lastname }}</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-500">Téléphone :</span>
                            <p class="font-medium text-gray-800">{{ comment.phone }}</p>
                        </div>
                        {% if comment.email %}
                        <div>
                            <span class="text-sm text-gray-500">Email :</span>
                            <p class="font-medium text-gray-800">{{ comment.email }}</p>
                        </div>
                        {% endif %}
                        <div>
                            <span class="text-sm text-gray-500">IP Address :</span>
                            <p class="font-medium text-gray-800">{{ comment.ipAddress }}</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-500">User Agent :</span>
                            <p class="font-medium text-gray-800 text-xs">{{ comment.userAgent }}</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-500">Date :</span>
                            <p class="font-medium text-gray-800">{{ comment.createdAt|date('d/m/Y à H:i:s') }}</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-500">Statut :</span>
                            {% if comment.isApproved %}
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    Approuvé
                                </span>
                            {% elseif comment.isRejected %}
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    Rejeté
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-amber-100 text-amber-700 rounded-full text-xs">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    En attente
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">Commentaire</h2>
                    <div class="p-4 bg-amber-50 rounded-xl">
                        <p class="text-gray-700 leading-relaxed">{{ comment.content|raw }}</p>
                    </div>
                </div>
                
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-3">Article concerné</h2>
                    <div class="p-4 bg-gray-50 rounded-xl">
                        <a href="{{ path('app_single_article_public', {'slug': comment.article.slug}) }}" target="_blank" class="text-amber-600 hover:text-amber-700 font-medium">
                            {{ comment.article.title }}
                        </a>
                    </div>
                </div>
                
                <div class="flex gap-3 pt-4 border-t border-gray-200">
                    {% if not comment.isApproved and not comment.isRejected %}
                        <form method="POST" action="{{ path('app_admin_comments_approve', {'id': comment.id}) }}">
                            <input type="hidden" name="redirect_status" value="{{ app.request.query.get('status', 'pending') }}">
                            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                Approuver le commentaire
                            </button>
                        </form>
                        <form method="POST" action="{{ path('app_admin_comments_reject', {'id': comment.id}) }}">
                            <input type="hidden" name="redirect_status" value="{{ app.request.query.get('status', 'pending') }}">
                            <button type="submit" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors">
                                Rejeter le commentaire
                            </button>
                        </form>
                    {% endif %}
                    <form method="POST" action="{{ path('app_admin_comments_delete', {'id': comment.id}) }}" 
                          onsubmit="return confirm('Supprimer définitivement ce commentaire ? Cette action est irréversible.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                        <input type="hidden" name="redirect_status" value="{{ app.request.query.get('status', 'pending') }}">
                        <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                            Supprimer définitivement
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}