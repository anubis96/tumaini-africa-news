{# templates/admin/tag/show.html.twig #}
{% extends 'admin/dashboard.html.twig' %}

{% block title %}Tag : {{ tag.name }}{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-4xl mx-auto">
        {# Fil d'Ariane #}
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <a href="{{ path('app_tag_index') }}" class="hover:text-amber-600">Tags</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>{{ tag.name }}</span>
        </div>

        {# Tag #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            {# En-tête #}
            <div class="h-24" style="background: linear-gradient(135deg, {{ tag.color ?? '#d4af37' }} 0%, {{ tag.color ?? '#d4af37' }}80 100%);"></div>
            
            <div class="p-6">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="text-5xl">🏷️</div>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800 dark:text-white flex items-center gap-3">
                                {{ tag.name }}
                                <span class="text-sm font-medium px-3 py-1 rounded-full" style="background-color: {{ tag.color ?? '#d4af37' }}20; color: {{ tag.color ?? '#d4af37' }}; border: 1px solid {{ tag.color ?? '#d4af37' }}40;">
                                    #{{ tag.slug }}
                                </span>
                            </h1>
                            <p class="text-gray-500 dark:text-gray-400 mt-1">{{ tag.getCategoryLabel() }}</p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('app_tag_edit', {'id': tag.id}) }}" 
                           class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Modifier
                        </a>
                    </div>
                </div>

                {# Informations #}
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 text-center">
                        <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ tag.usageCount }}</p>
                        <p class="text-xs text-gray-500">Articles associés</p>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 text-center">
                        <p class="text-2xl font-bold text-gray-800 dark:text-white">
                            {% if tag.isActive %}
                                <span class="text-green-500">✓</span>
                            {% else %}
                                <span class="text-red-500">✗</span>
                            {% endif %}
                        </p>
                        <p class="text-xs text-gray-500">Statut</p>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 text-center">
                        <p class="text-2xl font-bold text-gray-800 dark:text-white">
                            <span class="inline-block w-6 h-6 rounded-full" style="background-color: {{ tag.color ?? '#d4af37' }}"></span>
                        </p>
                        <p class="text-xs text-gray-500">Couleur</p>
                    </div>
                </div>

                {# Articles associés #}
                {% if tag.articles|length > 0 %}
                <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Articles associés ({{ tag.articles|length }})</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700">
                                <tr>
                                    <th class="px-6 py-3">Titre</th>
                                    <th class="px-6 py-3">Catégorie</th>
                                    <th class="px-6 py-3">Date</th>
                                    <th class="px-6 py-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for article in tag.articles %}
                                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                                    <td class="px-6 py-4">{{ article.title|slice(0, 60) }}{% if article.title|length > 60 %}...{% endif %}</td>
                                    <td class="px-6 py-4">{{ article.category.name }}</td>
                                    <td class="px-6 py-4">{{ article.createdAt|date('d/m/Y') }}</td>
                                    <td class="px-6 py-4">
                                        <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="text-amber-600 hover:text-amber-800">Modifier</a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}

                {# Actions #}
                <div class="flex justify-between items-center mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <a href="{{ path('app_tag_index') }}" 
                       class="px-5 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour à la liste
                    </a>
                    {{ include('admin/tag/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}