{% extends 'admin/dashboard.html.twig' %}

{% block title %}Modifier - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-3xl mx-auto">
        {# Fil d'Ariane #}
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <a href="{{ path('app_user_index') }}" class="hover:text-amber-600">Utilisateurs</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>Modifier</span>
        </div>

        {# En-tête #}
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Modifier : {{ user.firstname }} {{ user.lastname }}
            </h1>
        </div>

        {# Formulaire #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-6">
                {{ include('admin/user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>

        {# Zone de suppression #}
        {% if app.user.id != user.id %}
            <div class="mt-6 bg-red-50 dark:bg-red-900/20 rounded-xl border border-red-200 dark:border-red-800 p-6">
                <div class="flex items-center justify-between flex-wrap gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-red-800 dark:text-red-400 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            Zone dangereuse
                        </h3>
                        <p class="text-sm text-red-600 dark:text-red-300 mt-1">
                            La suppression d'un utilisateur est irréversible.
                        </p>
                    </div>
                    {{ include('admin/user/_delete_form.html.twig') }}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}