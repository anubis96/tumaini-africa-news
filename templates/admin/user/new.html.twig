{% extends 'admin/dashboard.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-3xl mx-auto">
        {# En-tête #}
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Nouvel utilisateur
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Créez un compte utilisateur avec un mot de passe généré automatiquement</p>
        </div>

        {# Formulaire #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-6">
                {{ include('admin/user/_form.html.twig', {'button_label': 'Créer l\'utilisateur', 'generated_password': generated_password}) }}
            </div>
        </div>
        {# templates/admin/user/_form.html.twig - Ajoutez ce bloc après le formulaire #}

{% if generated_password is defined and generated_password %}
    <div class="mt-6 bg-amber-50 dark:bg-amber-900/30 rounded-lg p-4 border border-amber-200 dark:border-amber-800">
        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <h4 class="text-sm font-semibold text-amber-800 dark:text-amber-400 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                    Mot de passe généré
                </h4>
                <p class="text-sm text-amber-700 dark:text-amber-300 mt-1">
                    Ce mot de passe doit être communiqué à l'utilisateur.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <code id="generatedPassword" class="px-3 py-2 bg-white dark:bg-gray-800 rounded-lg font-mono text-sm border border-amber-300 dark:border-amber-700">
                    {{ generated_password }}
                </code>
                <button type="button" onclick="copyPassword()" 
                        class="p-2 text-amber-600 hover:bg-amber-100 rounded-lg transition" title="Copier">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
{% endif %}

<script>
    function copyPassword() {
        const password = document.getElementById('generatedPassword');
        if (password) {
            const textarea = document.createElement('textarea');
            textarea.value = password.innerText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            
            // Feedback visuel
            const btn = event.currentTarget;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
            setTimeout(() => {
                btn.innerHTML = originalHtml;
            }, 2000);
        }
    }
</script>
    </div>
</div>
{% endblock %}