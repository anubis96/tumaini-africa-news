{% extends 'admin/dashboard.html.twig' %}

{% block title %}Utilisateur - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block in_body %}
<div class="w-full max-w-full bg-gray-50 dark:bg-gray-900 p-4 overflow-x-hidden">
    <div class="max-w-4xl mx-auto">
        {# Fil d'Ariane #}
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
            <a href="{{ path('app_user_index') }}" class="hover:text-amber-600">Utilisateurs</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>{{ user.firstname }} {{ user.lastname }}</span>
        </div>

        {# Profil utilisateur #}
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            {# En-tête #}
            <div class="h-32 bg-orange-500"></div>
            
            <div class="relative px-6 pb-6">
                {# Avatar #}
                <div class="absolute -top-12 left-6">
                    <div class="w-24 h-24 rounded-full border-4 border-white dark:border-gray-800 shadow-lg bg-amber-500 flex items-center justify-center">
                        <span class="text-3xl font-bold text-white">
                            {{ user.firstname ? user.firstname|first ~ user.lastname|first : (user.username ? user.username|first|upper : 'U') }}
                        </span>
                    </div>
                </div>
                
                {# Actions #}
                <div class="flex justify-end pt-4">
                    <div class="flex gap-2">
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" 
                           class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Modifier
                        </a>
                        {% if app.user.id != user.id %}
                            <button type="button" 
                                    onclick="confirmDelete({{ user.id }}, '{{ user.firstname }} {{ user.lastname }}')"
                                    class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                Supprimer
                            </button>
                        {% endif %}
                    </div>
                </div>
                
                {# Informations #}
                <div class="mt-16">
                    <h1 class="text-2xl font-bold text-gray-800 dark:text-white">{{ user.firstname }} {{ user.lastname }}</h1>
                    <p class="text-amber-600 dark:text-amber-400">@{{ user.username }}</p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                        <div class="space-y-4">
                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Informations de contact</h3>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                        <span class="text-gray-600 dark:text-gray-400">{{ user.email }}</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Rôle</h3>
                                <div>
                                    {% if 'ROLE_ADMIN' in user.roles %}
                                        <span class="inline-flex items-center gap-1 px-3 py-1 text-sm font-semibold rounded-full bg-purple-100 text-purple-700">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                                            </svg>
                                            Administrateur
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 px-3 py-1 text-sm font-semibold rounded-full bg-blue-100 text-blue-700">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                            </svg>
                                            Utilisateur
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Statistiques</h3>
                            <div class="grid grid-cols-3 gap-4 text-center">
                                <div>
                                    <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ user.articles|length }}</p>
                                    <p class="text-xs text-gray-500">Articles</p>
                                </div>
                                <div>
                                    <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ user.audio|length }}</p>
                                    <p class="text-xs text-gray-500">Podcasts</p>
                                </div>
                                <div>
                                    <p class="text-2xl font-bold text-gray-800 dark:text-white">{{ user.comments|length }}</p>
                                    <p class="text-xs text-gray-500">Commentaires</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                {# Retour #}
                <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <a href="{{ path('app_user_index') }}" 
                       class="inline-flex items-center gap-2 text-gray-600 hover:text-amber-600 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour à la liste des utilisateurs
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{# Formulaire de suppression #}
<form id="deleteForm" method="post" action="" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}" id="deleteToken">
</form>

{# Modal de confirmation #}
<div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6" id="deleteMessage"></p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeDeleteModal()" class="px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">Annuler</button>
                <button type="button" onclick="submitDelete()" class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Supprimer</button>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteId = null;
    function confirmDelete(id, name) {
        deleteId = id;
        document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer l'utilisateur <strong>"${name}"</strong> ? Cette action est irréversible.`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.getElementById('deleteModal').classList.add('flex');
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        document.getElementById('deleteModal').classList.remove('flex');
        deleteId = null;
    }
    function submitDelete() {
        if (deleteId) {
            const form = document.getElementById('deleteForm');
            form.action = "{{ path('app_user_delete', {'id': 0}) }}".replace('0', deleteId);
            form.submit();
        }
    }
    document.getElementById('deleteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>
{% endblock %}