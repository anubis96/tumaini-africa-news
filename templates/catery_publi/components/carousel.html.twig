{# templates/catery_publi/components/carousel.html.twig #}
<!-- News Carousel Component -->
<div class="relative w-full" id="newsCarousel">
    <!-- Main Carousel Container -->
    <div class="relative h-[400px] md:h-[500px] lg:h-[550px] overflow-hidden rounded-lg shadow-xl bg-white">
        <!-- Carousel Track -->
        <div class="carousel-track flex transition-transform duration-500 ease-in-out h-full" id="carouselTrack">
            {% for article in items %}
            <div class="carousel-slide min-w-full h-full relative {{ loop.first ? 'active' : '' }}" data-slide="{{ loop.index0 }}">
                <!-- Image Container -->
                <div class="absolute inset-0 md:w-2/3 lg:w-3/5">
                    <img src="{{ (vich_uploader_asset(article, 'imageFile')|default('/images/static/default.jpg'))|imagine_filter('thumb_hero') }}" 
                         alt="{{ article.title }}" 
                         class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent md:hidden"></div>
                </div>
                
                <!-- Content Panel -->
                <div class="absolute inset-0 md:left-2/3 lg:left-3/5 bg-white md:bg-gradient-to-r md:from-white md:via-white md:to-gray-50 flex items-center">
                    <div class="p-6 md:p-8 lg:p-10 w-full">
                        <!-- Category Badge -->
                        <div class="mb-4">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-600 text-white">
                                {{ article.category.name }}
                            </span>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900 mb-3 leading-tight">
                            <a class="hover:text-amber-600 transition-colors" href="{{ path('app_single_article_public', {'slug': article.slug}) }}">
                                {{ article.title }}
                            </a>
                        </h3>
                        
                        <!-- Content -->
                        <p class="text-sm text-gray-500 mb-6 line-clamp-3 hidden md:block">
                            {{ article.content|striptags|slice(0, 150) }} ...
                        </p>
                        
                        <!-- Meta Information -->
                        <div class="flex flex-col gap-3 mb-6">
                            <div class="flex items-center text-xs text-gray-500 space-x-4">
                                <span class="flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    La Redaction
                                </span>
                                <span class="flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    3 min
                                </span>
                                <span class="flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    {{ article.publishedAt|date('M d, Y') }}
                                </span>
                            </div>
                        </div>
                        
                        <!-- Read More Button -->
                        <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}" 
                           class="inline-flex items-center px-4 py-2 bg-amber-600 text-white text-sm font-medium rounded-lg hover:bg-amber-700 transition-colors group">
                            Voir plus
                            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>
                
                <!-- Mobile Content Overlay -->
                <div class="absolute bottom-0 left-0 right-0 p-6 text-white md:hidden bg-gradient-to-t from-black/80 to-transparent">
                    <h3 class="text-lg font-bold mb-2 leading-tight">{{ article.title|slice(0, 60) }}...</h3>
                    <div class="flex items-center text-xs space-x-3">
                        <span>{{ article.author.firstname }}</span>
                        <span>{{ article.publishedAt|date('M d') }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <!-- Navigation Arrows -->
        <button class="carousel-btn carousel-btn-prev absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 bg-black/50 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-amber-600 transition-all duration-200 hover:scale-110" id="prevBtn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        
        <button class="carousel-btn carousel-btn-next absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 bg-black/50 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-amber-600 transition-all duration-200 hover:scale-110" id="nextBtn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
        
        <!-- Slide Counter -->
        <div class="absolute top-4 right-4 z-20 bg-black/50 backdrop-blur-sm text-white text-xs px-3 py-1 rounded-full">
            <span id="currentSlide">1</span> / <span id="totalSlides">{{ items|length }}</span>
        </div>
    </div>
    
    <!-- Thumbnail Navigation -->
    <div class="flex justify-center mt-6 space-x-2 overflow-x-auto pb-2 scrollbar-hide" id="carouselThumbs">
        {% for item in items %}
        <button class="carousel-thumb shrink-0 w-20 h-16 rounded-lg overflow-hidden border-2 transition-all duration-200 {{ loop.first ? 'border-amber-600 shadow-md' : 'border-gray-300' }}" 
                data-slide="{{ loop.index0 }}">
            <img src="{{ (vich_uploader_asset(item, 'imageFile')|default('/images/static/default.jpg'))|imagine_filter('thumb_small') }}" 
                 alt="{{ item.title }}" 
                 class="w-full h-full object-cover">
        </button>
        {% endfor %}
    </div>
    
    <!-- Progress Bar -->
    <div class="mt-4 w-full bg-gray-200 rounded-full h-1 overflow-hidden">
        <div class="carousel-progress h-full bg-amber-600 rounded-full transition-all duration-300 ease-linear" 
             id="carouselProgress" style="width: 0%"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Carrousel
    const track = document.getElementById('carouselTrack');
    const slides = document.querySelectorAll('.carousel-slide');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const thumbs = document.querySelectorAll('.carousel-thumb');
    const progressBar = document.getElementById('carouselProgress');
    const currentSlideSpan = document.getElementById('currentSlide');
    const totalSlides = slides.length;
    
    if (totalSlides === 0) return;
    
    let currentIndex = 0;
    let autoPlayInterval;
    const autoPlayDelay = 6000;
    
    function updateCarousel() {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        
        if (currentSlideSpan) {
            currentSlideSpan.textContent = currentIndex + 1;
        }
        
        const progress = ((currentIndex + 1) / totalSlides) * 100;
        if (progressBar) {
            progressBar.style.width = `${progress}%`;
        }
        
        thumbs.forEach((thumb, index) => {
            if (index === currentIndex) {
                thumb.classList.add('border-amber-600', 'shadow-md');
                thumb.classList.remove('border-gray-300');
            } else {
                thumb.classList.remove('border-amber-600', 'shadow-md');
                thumb.classList.add('border-gray-300');
            }
        });
    }
    
    function nextSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateCarousel();
        resetAutoPlay();
    }
    
    function prevSlide() {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateCarousel();
        resetAutoPlay();
    }
    
    function goToSlide(index) {
        currentIndex = index;
        updateCarousel();
        resetAutoPlay();
    }
    
    function resetAutoPlay() {
        if (autoPlayInterval) {
            clearInterval(autoPlayInterval);
        }
        autoPlayInterval = setInterval(nextSlide, autoPlayDelay);
    }
    
    function startAutoPlay() {
        autoPlayInterval = setInterval(nextSlide, autoPlayDelay);
    }
    
    function stopAutoPlay() {
        if (autoPlayInterval) {
            clearInterval(autoPlayInterval);
        }
    }
    
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);
    
    thumbs.forEach((thumb, index) => {
        thumb.addEventListener('click', () => goToSlide(index));
    });
    
    const carouselContainer = document.getElementById('newsCarousel');
    if (carouselContainer) {
        carouselContainer.addEventListener('mouseenter', stopAutoPlay);
        carouselContainer.addEventListener('mouseleave', startAutoPlay);
    }
    
    startAutoPlay();
    updateCarousel();
});
</script>

<style>
.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
.scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>