{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}TUMAINI AFRICA NEWS | {{ controller_name }}{% endblock %}

{% block body %}
    <!-- Breaking news ticker -->
    <div class="bg-gray-900 text-white py-2 overflow-hidden">
        <div class="container mx-auto px-4">
            <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-1 bg-red-600 px-3 py-1 rounded-full text-xs font-bold uppercase animate-pulse">
                    <span class="w-2 h-2 bg-white rounded-full animate-ping"></span>
                    {{ 'home.live'|trans }}
                </span>
                <div class="flex-1 overflow-hidden">
                    <div class="ticker whitespace-nowrap animate-marquee">
                        {% for article in urgents|slice(0, 5) %}
                            <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}" class="mx-4 text-sm hover:text-amber-400 transition-colors">
                                🔴 {{ article.title }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modal Publicité Premium #}
    <div id="advertise-modal" tabindex="-1" aria-hidden="true" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm transition-all duration-300">
        <div class="relative mx-4 w-full max-w-2xl transform overflow-hidden rounded-2xl bg-white shadow-2xl transition-all duration-300 animate-fadeInUp">
            <div class="relative custom-gradient px-6 py-4">
                <h3 id="modal-title" class="text-xl font-bold text-white tracking-wide"></h3>
                <button type="button" class="absolute right-4 top-4 text-white/80 hover:text-white transition-colors" data-modal-hide="advertise-modal">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div id="modal-body" class="p-6 space-y-4 text-gray-700"></div>
            <div class="border-t border-gray-100 px-6 py-4 bg-gray-50">
                <button data-modal-hide="advertise-modal" class="rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-amber-700 hover:shadow-md">Fermer</button>
            </div>
        </div>
    </div>

    {# Hero Carousel Publicités #}
    <div class="relative mx-auto max-w-6xl px-4 my-6">
        <div class="relative overflow-hidden rounded-2xl shadow-xl">
            <div id="fixedCarousel" class="flex transition-transform duration-700 ease-out">
                {% for i in 0..2 %}
                <div class="carousel-fixed-item relative h-[220px] w-full flex-shrink-0 md:h-[280px]">
                    {% if i < advertises_count and last_advertise[i] %}
                        {% set imageUrl = vich_uploader_asset(last_advertise[i], 'imageFile') %}
                        <img src="{{ imageUrl ?: 'images/static/default.png' }}" 
                             alt="{{ last_advertise[i].title }}" 
                             loading="lazy"
                             decoding="async"
                             width="1200"
                             height="280"
                             class="h-full w-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                            <span class="inline-block rounded-full bg-amber-500 px-3 py-1 text-xs font-bold uppercase shadow-lg">Publicité</span>
                            <h3 class="mt-2 text-xl font-bold">{{ last_advertise[i].company }}</h3>
                            <p class="text-sm opacity-90">{{ last_advertise[i].title }}</p>
                            <button onclick="showAdvertiseModal({{ last_advertise[i].id }})" class="mt-2 inline-flex items-center text-amber-300 hover:text-amber-200 font-semibold text-sm transition-colors">
                                {{ 'home.read_more'|trans }} →
                            </button>
                        </div>
                    {% else %}
                        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                            <div class="text-center p-4">
                                <p class="text-gray-500">{{ 'home.advertise_space'|trans }}</p>
                                <a href="/contact" class="mt-2 inline-block text-amber-600 text-sm">{{ 'home.contact_us'|trans }}</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <button class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white backdrop-blur-sm transition-all hover:bg-amber-600 hover:scale-110">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white backdrop-blur-sm transition-all hover:bg-amber-600 hover:scale-110">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2">
                {% for i in 0..2 %}
                <button class="carousel-dot h-2 w-2 rounded-full transition-all data-[active=true]:w-6 data-[active=true]:bg-amber-500 bg-white/60" data-index="{{ i }}"></button>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Section principale -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-8">
        <div class="container mx-auto px-4">
            <div class="flex flex-col gap-8 lg:flex-row">
                
                <!-- Colonne principale -->
                <div class="w-full lg:w-2/3">
                    
                    <!-- Mega Carousel des articles urgents -->
                    <div class="relative mb-8 overflow-hidden rounded-2xl shadow-xl group">
                        <div id="urgentCarousel" class="flex transition-transform duration-700 ease-out">
                            {% for article in urgents %}
                            <div class="relative h-[500px] w-full flex-shrink-0 md:h-[550px]">
                                <img src="{{ vich_uploader_asset(article, 'imageFile')|default('images/static/default.png') }}" 
                                     alt="{{ article.title }}" 
                                     loading="lazy"
                                     decoding="async"
                                     width="1200"
                                     height="550"
                                     class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
                                <div class="absolute bottom-0 left-0 right-0 p-6 text-white md:p-8">
                                    <span class="inline-block rounded-full bg-amber-500 px-3 py-1 text-xs font-bold uppercase tracking-wide shadow-lg">{{ article.category.name }}</span>
                                    <h1 class="mt-3 text-2xl font-bold leading-tight md:text-3xl lg:text-4xl">
                                        <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}" class="hover:text-amber-300 transition-colors">
                                            {{ article.title }}
                                        </a>
                                    </h1>
                                    <p class="mt-2 text-sm text-gray-200">{{ 'home.by'|trans }} La Redaction • {{ article.publishedAt|date('d/m/Y à H:i') }}</p>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        <button class="urgent-prev absolute left-4 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white backdrop-blur-sm transition-all hover:bg-amber-600">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button class="urgent-next absolute right-4 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white backdrop-blur-sm transition-all hover:bg-amber-600">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>

                    <!-- Dernières nouvelles + Catégories -->
                    <div class="rounded-2xl bg-white p-6 shadow-lg">
                        <div class="flex flex-col gap-8 lg:flex-row">
                            <!-- Article vedette -->
                            <div class="lg:w-1/2">
                                <div class="border-b-2 border-amber-500 pb-2 mb-4 inline-block">
                                    <h2 class="text-2xl font-bold text-gray-800">{{ 'home.featured'|trans }}</h2>
                                </div>
                                <a href="{{ path('app_single_article_public', {'slug': lastFirst.slug}) }}" class="group block">
                                    <div class="overflow-hidden rounded-xl mb-4">
                                        <img class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                             src="{{ vich_uploader_asset(lastFirst, 'imageFile')|default('images/static/default.png') }}" 

                                             alt="{{ lastFirst.title }}"
                                             loading="lazy"
                                             decoding="async"
                                             width="400"
                                             height="256">
                                    </div>
                                    <h3 class="text-xl font-bold text-gray-800 group-hover:text-amber-600 transition-colors">{{ lastFirst.title }}</h3>
                                    <p class="mt-2 text-sm text-gray-500">{{ 'home.by'|trans }} La Redaction • {{ lastFirst.publishedAt|date('d M Y') }}</p>
                                    <p class="mt-3 text-gray-600 line-clamp-3">{{ lastFirst.content|striptags|slice(0, 120) }}...</p>
                                    <span class="mt-3 inline-flex items-center text-amber-600 font-medium group-hover:translate-x-1 transition-transform">{{ 'home.read_more'|trans }} →</span>
                                </a>
                            </div>
                            
                            <!-- Catégories et articles récents -->
                            <div class="lg:w-1/2">
                                <div class="flex flex-wrap gap-2 mb-6">
                                    {% for category in categories %}
                                        <a href="{{ path('app_home', {'category': category.slug}) }}" 
                                           class="rounded-full px-4 py-1.5 text-sm font-medium transition-all
                                                  {% if selected_category and selected_category.id == category.id %}
                                                      bg-amber-600 text-white shadow-md
                                                  {% else %}
                                                      bg-gray-100 text-gray-700 hover:bg-amber-100 hover:text-amber-700
                                                  {% endif %}">
                                            {{ category.name }}
                                        </a>
                                    {% endfor %}
                                </div>
                                <div class="space-y-4">
                                    {% for article in category_articles|slice(0, 4) %}
                                        <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}" class="group flex gap-4 transition-all hover:bg-gray-50 rounded-lg p-2 -mx-2">
                                            <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-lg">
                                                <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" 
                                                     src="{{ vich_uploader_asset(article, 'imageFile')|default('images/static/default.png') }}" 
                                                     alt="{{ article.title }}"
                                                     loading="lazy"
                                                     decoding="async"
                                                     width="80"
                                                     height="80">
                                            </div>
                                            <div class="flex-1">
                                                <p class="text-xs text-amber-600 font-semibold uppercase">{{ article.category.name }}</p>
                                                <h4 class="font-semibold text-gray-800 group-hover:text-amber-600 transition-colors line-clamp-2">{{ article.title }}</h4>
                                                <p class="text-xs text-gray-400 mt-1">{{ article.publishedAt|date('d M Y') }}</p>
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Publicité milieu premium -->
                    {% if middle_advertise %}
                    <div class="mt-8 overflow-hidden rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border-l-4 border-amber-500 shadow-md hover:shadow-lg transition-all">
                        <div class="p-6">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="inline-block rounded-full bg-amber-500 px-3 py-0.5 text-xs font-bold text-white uppercase">Sponsorisé</span>
                                <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            </div>
                            <div class="flex flex-col md:flex-row gap-6 items-center">
                                {% if vich_uploader_asset(middle_advertise, 'imageFile') %}
                                    <img src="{{ vich_uploader_asset(middle_advertise, 'imageFile') }}" 
                                         alt="{{ middle_advertise.title }}" 
                                         loading="lazy"
                                         decoding="async"
                                         width="160"
                                         height="128"
                                         class="w-full md:w-40 h-32 object-cover rounded-xl shadow-md">
                                {% endif %}
                                <div>
                                    <h3 class="text-xl font-bold text-gray-800">{{ middle_advertise.title }}</h3>
                                    <p class="text-gray-600 mt-1">{{ middle_advertise.description|slice(0, 100) }}...</p>
                                    <div class="mt-3 flex flex-wrap gap-4">
                                        {% if middle_advertise.phoneNumber %}
                                            <a href="tel:{{ middle_advertise.phoneNumber }}" class="flex items-center text-amber-600 hover:text-amber-700 text-sm">
                                                <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                                {{ middle_advertise.phoneNumber }}
                                            </a>
                                        {% endif %}
                                        {% if middle_advertise.email %}
                                            <a href="mailto:{{ middle_advertise.email }}" class="flex items-center text-amber-600 hover:text-amber-700 text-sm">
                                                <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                                {{ middle_advertise.email }}
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>

                <!-- Sidebar droite -->
                <div class="w-full lg:w-1/3 space-y-6">
                    <!-- Articles secondaires -->
                    <div class="space-y-4">
                        {% for article in [lastSecond, lastThird] %}
                        <div class="group relative overflow-hidden rounded-xl shadow-lg">
                            <img src="{{ vich_uploader_asset(article, 'imageFile')|default('images/static/default.png') }}" 
                                 alt="{{ article.title }}" 
                                 loading="lazy"
                                 decoding="async"
                                 width="600"
                                 height="224"
                                 class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                            <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
                                <span class="inline-block rounded-full bg-amber-500 px-2 py-0.5 text-xs font-bold uppercase">{{ article.category.name }}</span>
                                <h3 class="mt-2 text-lg font-bold leading-tight">
                                    <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}" class="hover:text-amber-300 transition-colors">
                                        {{ article.title }}
                                    </a>
                                </h3>
                                <p class="mt-1 text-xs text-gray-200">{{ 'home.by'|trans }} La Redaction• {{ article.publishedAt|date('d M Y') }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    <!-- Articles les plus vus -->
                    <div class="rounded-2xl bg-white p-5 shadow-lg">
                        <div class="mb-4 flex items-center gap-2 border-b-2 border-amber-500 pb-2">
                            <svg class="h-6 w-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            <h2 class="text-xl font-bold text-gray-800">{{ 'home.trending'|trans }}</h2>
                        </div>
                        
                        <div class="relative mb-6 overflow-hidden rounded-xl">
                            <img src="{{ vich_uploader_asset(first_viewed, 'imageFile')|default('images/static/default.png') }}" 
                                 alt="{{ first_viewed.title }}" 
                                 loading="lazy"
                                 decoding="async"
                                 width="400"
                                 height="288"
                                 class="h-72 w-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                            <div class="absolute bottom-0 p-4 text-white">
                                <span class="inline-block rounded-full bg-amber-500 px-2 py-0.5 text-xs font-bold">{{ first_viewed.category.name }}</span>
                                <h3 class="mt-1 text-lg font-bold"><a href="{{ path('app_single_article_public', {'slug': first_viewed.slug}) }}" class="hover:text-amber-300">{{ first_viewed.title }}</a></h3>
                                <div class="mt-1 flex items-center gap-3 text-xs">
                                {% if app.user %}
                                    <span>👁️ {{ first_viewed.viewCount }} {{ 'home.views'|trans }}</span>
                                {% endif %}
                                    <span>📅 {{ first_viewed.publishedAt|date('d/m/Y') }}</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="space-y-3">
                            {% for item in most_viewed|slice(1, 5) %}
                            <a href="{{ path('app_single_article_public', {'slug': item.slug}) }}" class="group flex gap-3 transition-all hover:bg-gray-50 rounded-lg p-2 -mx-2">
                                <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg">
                                    <img src="{{ vich_uploader_asset(item, 'imageFile')|default('images/static/default.png') }}" 
                                         class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                                         loading="lazy"
                                         decoding="async"
                                         width="64"
                                         height="64"
                                         alt="{{ item.title }}">
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-sm font-semibold text-gray-800 group-hover:text-amber-600 transition-colors line-clamp-2">{{ item.title }}</h4>
                                    <div class="mt-1 flex items-center gap-2 text-xs text-gray-400">
                                    {% if app.user %}
                                        <span>👁️ {{ item.viewCount }}</span>
                                    {% endif %}
                                        <span>{{ item.publishedAt|date('d/m/Y') }}</span>
                                    </div>
                                </div>
                            </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section tendances horizontale -->
    <section class="bg-gray-50 py-10">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-2">
                    <svg class="h-7 w-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    <h2 class="text-2xl font-bold text-gray-800">{{ 'home.weekly'|trans }}</h2>
                </div>
                <div class="flex gap-2">
                    <button id="trendPrev" class="rounded-full bg-white p-2 shadow-md text-gray-600 hover:bg-amber-500 hover:text-white transition-all">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    </button>
                    <button id="trendNext" class="rounded-full bg-white p-2 shadow-md text-gray-600 hover:bg-amber-500 hover:text-white transition-all">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>
            <div id="trendCarousel" class="flex gap-6 overflow-x-auto scrollbar-hide pb-4 snap-x">
                {% for article in trending %}
                <div class="w-72 flex-shrink-0 snap-start">
                    <div class="group rounded-xl bg-white shadow-md overflow-hidden transition-all hover:shadow-xl hover:-translate-y-1">
                        <div class="overflow-hidden h-44">
                            <img src="{{ vich_uploader_asset(article, 'imageFile')|default('images/static/default.png') }}" 
                                 class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                                 loading="lazy"
                                 decoding="async"
                                 width="288"
                                 height="176"
                                 alt="{{ article.title }}">
                        </div>
                        <div class="p-4">
                            <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
                                <span class="text-amber-600 font-semibold">{{ article.category.name }}</span>
                                {% if app.user %}
                                    <span>👁️ {{ article.viewCount }} {{ 'home.views'|trans }}</span>
                                {% endif %}
                            </div>
                            <h3 class="font-bold text-gray-800 group-hover:text-amber-600 transition-colors line-clamp-2">
                                <a href="{{ path('app_single_article_public', {'slug': article.slug}) }}">{{ article.title }}</a>
                            </h3>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
 
    {# <section class="py-12 bg-gradient-to-b from-gray-50 to-white">
        <div class="container mx-auto px-4">
