{% block js %}
<script>
// Modal data
const advertisesData = [
    {% for advertise in last_advertise %}
    {
        id: {{ advertise.id }},
        title: "{{ advertise.title|escape('js') }}",
        description: "{{ advertise.description|escape('js') }}",
        company: "{{ advertise.company|escape('js') }}",
        phoneNumber: "{{ advertise.phoneNumber|escape('js') }}",
        email: "{{ advertise.email|escape('js') }}",
        imageUrl: "{{ vich_uploader_asset(advertise, 'imageFile') ?: '' }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];

function showAdvertiseModal(advertiseId) {
    const advertise = advertisesData.find(a => a.id === advertiseId);
    if (advertise) {
        document.getElementById('modal-title').textContent = advertise.title;
        document.getElementById('modal-body').innerHTML = `
            <div class="space-y-3">
                ${advertise.description ? `<p>${advertise.description}</p>` : ''}
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div><span class="font-semibold">Entreprise:</span> ${advertise.company || '—'}</div>
                    ${advertise.phoneNumber ? `<div><span class="font-semibold">Tél:</span> ${advertise.phoneNumber}</div>` : ''}
                    ${advertise.email ? `<div><span class="font-semibold">Email:</span> ${advertise.email}</div>` : ''}
                </div>
                ${advertise.imageUrl ? `<img src="${advertise.imageUrl}" class="rounded-lg mt-2" loading="lazy">` : ''}
            </div>
        `;
        document.getElementById('advertise-modal').classList.remove('hidden');
        document.getElementById('advertise-modal').classList.add('flex');
    }
}

document.querySelectorAll('[data-modal-hide="advertise-modal"]').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('advertise-modal').classList.add('hidden');
        document.getElementById('advertise-modal').classList.remove('flex');
    });
});

// Fixed carousel
const fixedCarousel = document.getElementById('fixedCarousel');
const fixedItems = document.querySelectorAll('.carousel-fixed-item');
const fixedDots = document.querySelectorAll('.carousel-dot');
let fixedIndex = 0;

function updateFixedCarousel() {
    fixedCarousel.style.transform = `translateX(-${fixedIndex * 100}%)`;
    fixedDots.forEach((dot, i) => {
        dot.setAttribute('data-active', i === fixedIndex);
    });
}

document.querySelector('.carousel-prev')?.addEventListener('click', () => {
    fixedIndex = (fixedIndex - 1 + fixedItems.length) % fixedItems.length;
    updateFixedCarousel();
});

document.querySelector('.carousel-next')?.addEventListener('click', () => {
    fixedIndex = (fixedIndex + 1) % fixedItems.length;
    updateFixedCarousel();
});

fixedDots.forEach(dot => {
    dot.addEventListener('click', () => {
        fixedIndex = parseInt(dot.dataset.index);
        updateFixedCarousel();
    });
});

setInterval(() => {
    fixedIndex = (fixedIndex + 1) % fixedItems.length;
    updateFixedCarousel();
}, 8000);

// Urgent carousel
const urgentCarousel = document.getElementById('urgentCarousel');
if (urgentCarousel) {
    const urgentSlides = urgentCarousel.children;
    let urgentIndex = 0;

    function updateUrgentCarousel() {
        urgentCarousel.style.transform = `translateX(-${urgentIndex * 100}%)`;
    }

    document.querySelector('.urgent-prev')?.addEventListener('click', () => {
        urgentIndex = (urgentIndex - 1 + urgentSlides.length) % urgentSlides.length;
        updateUrgentCarousel();
    });

    document.querySelector('.urgent-next')?.addEventListener('click', () => {
        urgentIndex = (urgentIndex + 1) % urgentSlides.length;
        updateUrgentCarousel();
    });

    setInterval(() => {
        urgentIndex = (urgentIndex + 1) % urgentSlides.length;
        updateUrgentCarousel();
    }, 6000);
}

// Trend carousel scroll
const trendCarousel = document.getElementById('trendCarousel');
document.getElementById('trendPrev')?.addEventListener('click', () => {
    trendCarousel.scrollBy({ left: -300, behavior: 'smooth' });
});
document.getElementById('trendNext')?.addEventListener('click', () => {
    trendCarousel.scrollBy({ left: 300, behavior: 'smooth' });
});
</script>

<style>
/* Animations */
@keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

.animate-marquee {
    animation: marquee 25s linear infinite;
    display: inline-block;
}

.animate-marquee:hover {
    animation-play-state: paused;
}

.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
.scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
.animate-fadeInUp {
    animation: fadeInUp 0.3s ease-out;
}

/* Custom gradient */
.custom-gradient {
    background: linear-gradient(135deg, #d97706 0%, #f97316 100%);
}
</style>
