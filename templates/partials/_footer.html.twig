{# templates/partials/_footer.html.twig #}
<footer class="bg-gray-900 text-gray-300 mt-16">
    <!-- Newsletter section -->
    <div class="border-b border-gray-800">
        <div class="container mx-auto px-4 py-12">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-center md:text-left">
                    <h3 class="text-2xl font-bold text-white mb-2">{{ 'footer.not_miss'|trans }}</h3>
                    <p class="text-gray-400">{{ 'footer.newsletter'|trans }}</p>
                </div>
                <form class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                    <input type="email" placeholder="{{ 'home.your_email'|trans }}" 
                           class="px-5 py-3 rounded-xl bg-gray-800 border border-gray-700 text-white placeholder:text-gray-500 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none transition-all w-full sm:w-80">
                    <button class="px-6 py-3 text-white font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300" style="background: linear-gradient(to right, #d97706, #f97316);">
                        {{ 'home.subscribe'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Main footer -->
    <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- About -->
            <div>
                <div class="flex items-center gap-3 mb-4">
                    <img src="/images/static/tan-logo-optimized.png" width="40" height="40" loading="lazy" class="h-10 w-auto" alt="Tumaini Africa News">
                    <div>
                        <h3 class="text-white font-bold text-lg">{{ 'home.title'|trans }}</h3>
                        <p class="text-xs text-amber-500">{{ 'home.subtitle'|trans }}</p>
                    </div>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed mb-4">
                    {{ 'footer.description'|trans }}
                </p>
                <div class="flex gap-3">
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-800 flex items-center justify-center hover:bg-amber-600 transition-all group">
                        <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.99h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.99C18.343 21.128 22 16.991 22 12z"/>
                        </svg>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-800 flex items-center justify-center hover:bg-amber-600 transition-all group">
                        <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 0021.683-12.052c0-.21-.005-.42-.014-.63A9.935 9.935 0 0024 4.59z"/>
                        </svg>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-800 flex items-center justify-center hover:bg-amber-600 transition-all group">
                        <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-gray-800 flex items-center justify-center hover:bg-amber-600 transition-all group">
                        <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </a>
                </div>
            </div>
            
            <!-- Categories -->
            <div>
                <h4 class="text-white font-bold text-lg mb-4">Catégories populaires</h4>
                <ul class="space-y-2">
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Politique</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Économie</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Culture & Société</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Sports</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Technologie</a></li>
                    <li><a href="#" class="text-gray-400 hover:text-amber-400 transition-colors flex items-center gap-2"><span class="w-1 h-1 bg-amber-500 rounded-full"></span>Environnement</a></li>
                </ul>
            </div>
            
            <!-- Quick links -->
            <div>
                <h4 class="text-white font-bold text-lg mb-4">{{ 'footer.quick_links'|trans }}</h4>
                <ul class="space-y-2">
                    <li><a href="/about" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.contact_us'|trans }}</a></li>
                    <li><a href="/contact" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.about_us'|trans }}</a></li>
                    <li><a href="/privacy" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.privacy'|trans }}</a></li>
                    <li><a href="/terms" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.terms'|trans }}</a></li>
                    <li><a href="/advertise" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.advertise'|trans }}</a></li>
                    <li><a href="/careers" class="text-gray-400 hover:text-amber-400 transition-colors">{{ 'footer.careers'|trans }}</a></li>
                </ul>
            </div>
            
            <!-- Contact -->
            <div>
                <h4 class="text-white font-bold text-lg mb-4">{{ 'contact_us'|trans }}</h4>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span class="text-gray-400 text-sm">123 Avenue de la République, Kinshasa, RDC</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        <span class="text-gray-400">+243 123 456 789</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <span class="text-gray-400">contact@tumainiafricanews.info</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
    <!-- Bottom bar -->
    <div class="border-t border-gray-800 py-6">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
                <p class="text-gray-500 text-sm">
                    &copy; {{ "now"|date('Y') }} Tumaini Africa News. {{ 'footer.all_rights_reserved'|trans }}.
                </p>
                <div class="flex gap-6">
                    <a href="#" class="text-gray-500 text-sm hover:text-amber-400 transition-colors">Mentions légales</a>
                    <a href="#" class="text-gray-500 text-sm hover:text-amber-400 transition-colors">Cookies</a>
                    <a href="#" class="text-gray-500 text-sm hover:text-amber-400 transition-colors">Accessibilité</a>
                </div>
            </div>
        </div>
    </div>
</footer>