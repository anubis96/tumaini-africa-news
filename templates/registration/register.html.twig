{% extends 'base.html.twig' %}

{% block title %}Inscription - Rejoignez notre communauté{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        {# Messages flash #}
        {% for message in app.flashes('success') %}
            <div class="mb-4 bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg shadow-sm" role="alert">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {{ message }}
                </div>
            </div>
        {% endfor %}

        {# Carte d'inscription #}
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
            {# En-tête avec dégradé #}
            <div class="relative h-32 bg-orange-600">
                <div class="absolute -bottom-12 left-1/2 transform -translate-x-1/2">
                    <div class="w-24 h-24 rounded-full border-4 border-white dark:border-gray-800 shadow-lg bg-white dark:bg-gray-800 flex items-center justify-center">
                        <img src="images/static/tan-logos.png" alt="Logo" class="w-16 h-16 object-contain">
                    </div>
                </div>
            </div>

            {# Formulaire #}
            <div class="pt-16 pb-8 px-6 sm:px-8">
                <h1 class="text-2xl font-bold text-center text-gray-800 dark:text-white mb-2">
                    Créer un compte
                </h1>
                <p class="text-center text-gray-500 dark:text-gray-400 text-sm mb-6">
                    Rejoignez notre communauté et restez informé
                </p>

                {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}

                {# Affichage des erreurs globales #}
                {% if form_errors(registrationForm) %}
                    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-3 rounded-lg text-sm">
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                {# Nom d'utilisateur #}
                <div>
                    {{ form_label(registrationForm.username, 'Nom d\'utilisateur', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        {{ form_widget(registrationForm.username, {
                            'attr': {
                                'class': 'w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white',
                                'placeholder': 'ex: johndoe'
                            }
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.username, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                </div>

                {# Prénom et Nom - 2 colonnes #}
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        {{ form_label(registrationForm.firstname, 'Prénom', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            {{ form_widget(registrationForm.firstname, {
                                'attr': {
                                    'class': 'w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white',
                                    'placeholder': 'John'
                                }
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.firstname, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                    </div>
                    <div>
                        {{ form_label(registrationForm.lastname, 'Nom', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            {{ form_widget(registrationForm.lastname, {
                                'attr': {
                                    'class': 'w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white',
                                    'placeholder': 'Doe'
                                }
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.lastname, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                    </div>
                </div>

                {# Email #}
                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white',
                                'placeholder': 'exemple@email.com'
                            }
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.email, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                </div>

                {# Mot de passe #}
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        {{ form_widget(registrationForm.plainPassword, {
                            'attr': {
                                'class': 'w-full pl-10 pr-10 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white',
                                'placeholder': '••••••••'
                            }
                        }) }}
                        <button type="button" onclick="togglePassword('{{ registrationForm.plainPassword.vars.id }}')" 
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                        Minimum 6 caractères
                    </p>
                    {{ form_errors(registrationForm.plainPassword, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
                </div>

                {# Terms and conditions #}
                <div class="flex items-center gap-3 py-2">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {
                            'class': 'w-4 h-4 text-amber-600 bg-gray-100 border-gray-300 rounded focus:ring-amber-500'
                        }
                    }) }}
                    {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions générales d\'utilisation', {'label_attr': {'class': 'text-sm text-gray-700 dark:text-gray-300'}}) }}
                </div>
                {{ form_errors(registrationForm.agreeTerms, {'attr': {'class': 'text-red-500 text-xs'}}) }}

                {# Bouton d'inscription #}
                <button type="submit" 
                        class="w-full py-3 px-4 bg-orange-500 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2">
                    <div class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        S'inscrire
                    </div>
                </button>

                {{ form_end(registrationForm) }}

                {# Lien vers connexion #}
                <div class="mt-6 text-center">
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Vous avez déjà un compte ?
                        <a href="{{ path('app_login') }}" class="text-amber-600 hover:text-amber-700 font-medium hover:underline">
                            Se connecter
                        </a>
                    </p>
                </div>
            </div>
        </div>

        {# Message d'information sur l'activation #}
        <div class="mt-6 text-center text-xs text-gray-500 dark:text-gray-400">
            <p>En créant un compte, vous acceptez nos conditions générales.</p>
            <p class="mt-1">Votre compte devra être activé par un administrateur avant votre première connexion.</p>
        </div>
    </div>
</div>

<script>
    function togglePassword(fieldId) {
        const field = document.getElementById(fieldId);
        const type = field.getAttribute('type') === 'password' ? 'text' : 'password';
        field.setAttribute('type', type);
    }
</script>

<style>
    /* Animation d'entrée */
    .bg-white {
        animation: fadeInUp 0.5s ease-out;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Style pour les champs en focus */
    input:focus {
        outline: none;
    }
</style>
{% endblock %}